#!/bin/bash
# Commit-msg hook — SSOT tracked in scripts/hooks/
# Installed by: npm run system:install-hooks
#
# Blokuje podpisy AI w commit message (zasada projektu: zero stopek AI).
# $1 = plik z commit message (przekazywany przez git).

MSG_FILE="$1"

# Brak pliku message → nic do sprawdzenia
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

PATTERN='Co-Authored-By|Generated with|Generated by|🤖'

MATCHES=$(grep -inE "$PATTERN" "$MSG_FILE")

if [ -n "$MATCHES" ]; then
  echo ""
  echo "  COMMIT BLOCKED: podpis AI w commit message!"
  echo ""
  echo "$MATCHES" | sed 's/^/    /'
  echo ""
  echo "  Zasada projektu: commit message kończy się ostatnim zdaniem opisowym —"
  echo "  bez stopek 'Co-Authored-By: ...', 'Generated with/by ...', '🤖 ...'."
  echo "  Usuń podpis i spróbuj ponownie."
  exit 1
fi

exit 0
