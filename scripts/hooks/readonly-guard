#!/bin/bash
# READONLY Guard — pre-commit hook for submodules
#
# Prevents direct commits to READONLY-shared-kernel/.
# SMART: allows kernel propagation (content matches .shared-kernel/).
# Blocks direct edits (content differs from source).

READONLY_DIR="src/READONLY-shared-kernel"

# Get staged files matching READONLY path
STAGED_READONLY=$(git diff --cached --name-only -- "$READONLY_DIR" 2>/dev/null)

if [ -z "$STAGED_READONLY" ]; then
  exit 0
fi

# Resolve root project dir (submodule is one level deep: main/ or web-1/)
SUBMODULE_ROOT="$(git rev-parse --show-toplevel)"
PROJECT_ROOT="$(dirname "$SUBMODULE_ROOT")"
KERNEL_SOURCE="$PROJECT_ROOT/.shared-kernel"

# If .shared-kernel/ doesn't exist (not in root context) — fallback to blocking
if [ ! -d "$KERNEL_SOURCE" ]; then
  echo ""
  echo "  COMMIT BLOCKED: READONLY-shared-kernel modified outside root project."
  echo "  Cannot verify against .shared-kernel/ (not found at $KERNEL_SOURCE)."
  echo ""
  exit 1
fi

BLOCKED_FILES=()

while IFS= read -r staged_file; do
  [ -z "$staged_file" ] && continue

  # Extract relative path within READONLY-shared-kernel/
  rel_path="${staged_file#${READONLY_DIR}/}"
  source_file="$KERNEL_SOURCE/$rel_path"

  if [ ! -f "$source_file" ]; then
    # Check if this is a deletion (file removed from both kernel and READONLY)
    if ! git show ":0:$staged_file" >/dev/null 2>&1; then
      # Staged as deletion and kernel source doesn't exist — valid propagation of removal
      continue
    fi
    # File exists in READONLY but not in kernel — direct addition
    BLOCKED_FILES+=("$staged_file (no kernel source)")
    continue
  fi

  # Compare staged content with kernel source (pipe directly to avoid $() newline stripping)
  if ! git show ":0:$staged_file" 2>/dev/null | cmp -s - "$source_file"; then
    BLOCKED_FILES+=("$staged_file")
  fi
done <<< "$STAGED_READONLY"

if [ ${#BLOCKED_FILES[@]} -eq 0 ]; then
  echo "  Kernel propagation detected — allowing READONLY changes."
  exit 0
fi

echo ""
echo "  COMMIT BLOCKED: Direct edit of READONLY-shared-kernel detected!"
echo ""
echo "   These files differ from .shared-kernel/ (not a propagation)."
echo "   Edit the SSOT source in .shared-kernel/ instead,"
echo "   then run: npm run system:kernel"
echo ""
echo "   Blocked files:"
for f in "${BLOCKED_FILES[@]}"; do
  echo "     - $f"
done
echo ""
echo "   To unstage: git restore --staged $READONLY_DIR/"
echo ""
exit 1
