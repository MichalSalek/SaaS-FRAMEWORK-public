{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "incremental": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@kernel/*": ["../web-1/src/READONLY-shared-kernel/*"],
      "@app/*": ["../web-1/src/application/*"],
      "@domain/*": ["../web-1/src/domain/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
