#!/bin/bash

PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

FAILED=0

echo "  TypeScript check: main"
(cd "$PROJECT_ROOT/main" && ./node_modules/.bin/tsc --noEmit)
if [ $? -ne 0 ]; then FAILED=$((FAILED + 1)); fi

echo "  ESLint check: main"
(cd "$PROJECT_ROOT/main" && ./node_modules/.bin/eslint --max-warnings 0 .)
if [ $? -ne 0 ]; then FAILED=$((FAILED + 1)); fi

exit $FAILED
