# =============================================================================
# main (frontend — Next.js 16, Pages Router)
# >>> TEN PLIK = SZABLON (.env.example) | TRACKED w git | placeholdery, NIGDY realnych sekretow <<<
#
# To jest SSOT struktury env (lista zmiennych + ksztalt). Kopiuj do realnych plikow i wypelnij.
#
# KONWENCJA PLIKOW ENV — czytaj ZANIM cokolwiek zmienisz (AI i ludzie):
#   .env.development       -> DEVELOPMENT (localhost)     | gitignored | realne sekrety OK
#   .env.preview           -> PREVIEW (Render preview)    | poza snapshotem
#   .env.production        -> PRODUCTION (PRAWDZIWY prod) | poza snapshotem
#   .env.production.local  -> STAGING (!!)                | gitignored | realne sekrety OK
#   .env.example           -> SZABLON (placeholdery)      | TRACKED    | NIGDY realnych sekretow
#
# !!! .env.production.local TO STAGING (NODE_ENV_MANUAL=STAGING), NIE produkcja.
#     Plik produkcyjny = .env.production. Sufiks ".local" = top-priority dotenv + gitignored.
#
# NEXT_PUBLIC_ = BUILD-TIME: INLINOWANE do bundla przy `next build` (musi byc obecne PRZY
#   BUILDZIE; pusta = niewstrzykiwalna runtime bez rebuildu). Reszta = server-only (runtime).
# Walidacja main = kernel validateEnv (REQUIRED_VARS). DEVELOPMENT/STAGING = soft (warn);
#   PRODUCTION/PREVIEW = hard (crash gdy brak REQUIRED). Rejestr+decyzje: docs/DOMAIN/ENVIRONMENT_REFERENCE.md
# =============================================================================

# --- Environment / Runtime mode ---

# [OPTIONAL] Build-time tryb wdrozenia (server-only, NIE inlined). Decyduje o output:'standalone' w next.config.mjs i o soft/hard validate. Shape: enum DEVELOPMENT|STAGING|PREVIEW|PRODUCTION.
# PROD: ustaw PRODUCTION (inaczej build NIE bedzie standalone => zly deploy). STAGING realizowany przez .env.production.local.
NODE_ENV_MANUAL=DEVELOPMENT

# [OPTIONAL] Klientowy tryb (INLINED do bundla). Steruje IS_DEVELOPMENT_ENV/IS_PRODUCTION_ENV, ekspozycja window.ENV_VARS, soft/hard validate. Ma inline-fallback (?? NODE_ENV ?? 'DEVELOPMENT'). Shape: enum DEVELOPMENT|STAGING|PREVIEW|PRODUCTION.
# PROD: ustaw PRODUCTION.
NEXT_PUBLIC_NODE_ENV_MANUAL=DEVELOPMENT

# DEAD/build-time: czytane przez Next.js CLI (nie kod app) — wylacza telemetrie przy build/dev. Zostaje, bo dziala na poziomie frameworka. Shape: 1.
NEXT_TELEMETRY_DISABLED=1

# Pre-launch SEO gate. Bezpieczny default: brak/puste/false => site-wide noindex,nofollow.
# Launch: ustaw SEO_INDEXING_ENABLED=true (lub 1) i przebuduj/redeploy.
SEO_INDEXING_ENABLED=false

# --- Public URLs / Backend connection (build-time, inlined) ---

# [OPTIONAL] Schemat URL backendu. Fallback 'https://' w backend-url.ts/og-route. Shape: enum http://|https://.
# PROD: https://
NEXT_PUBLIC_HTTP_PROTOCOL=http://

# [REQUIRED] Domena backendu (Render/localhost). Pusta => buildBackendBaseUrl()='' (brak fetch) ORAZ prod-crash przez validateEnv. Shape: hostname/URL bez schematu (np. api.nailfolio.app).
# PROD: realna domena backendu Render.
NEXT_PUBLIC_BACKEND_PUBLIC_DOMAIN=localhost

# [OPTIONAL] Port backendu (poza REQUIRED_VARS — optional by design). Pusty dla Render (443). Shape: port-number jako string lub pusty.
# PROD: pusty (Render = 443).
NEXT_PUBLIC_BACKEND_PUBLIC_PORT=3001

# --- Media (Cloudinary) — public ---

# [REQUIRED] Nazwa konta Cloudinary do budowy URLi obrazow. Brak inline-fallback => pusty + PROD/PREVIEW = crash. Shape: slug (np. dcuiuwkb0).
# PROD: realny cloud_name z dashboardu Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Payments (Stripe) — publishable key is public-safe (shipped to browser) ---

# [REQUIRED dla embedded checkout] Stripe publishable key (pk_live/pk_test). Public by design — ladowany przez @stripe/stripe-js w przegladarce. Sekret (STRIPE_SECRET_KEY) zyje w web-1, NIE tutaj.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_KEY

# --- i18n (build-time, inlined) ---

# [REQUIRED] Domyslny jezyk. Brak inline-fallback w configu (kernel ma wtorny ?? 'pl', ale validateEnv liczy pusty jako missing). Shape: enum pl|en|de.
NEXT_PUBLIC_DEFAULT_LOCALE=pl

# [REQUIRED] Strefa czasowa formatowania dat. Brak inline-fallback w configu (kernel ma wtorny ?? 'Europe/Warsaw'). Shape: IANA TZ (Europe/Warsaw).
NEXT_PUBLIC_TIMEZONE=Europe/Warsaw

# --- Runtime flags ---

# [OPTIONAL] Czy logowac eventy do Event Log DB (gate w dev). Default false (normalizeBool). Inlined (NEXT_PUBLIC_). Shape: boolean true|false.
# (newVarsToAdd: uzyta w environment.config.ts + errorHandlerIO, wczesniej nieobecna w plikach .env — dodana dla spojnosci.)
NEXT_PUBLIC_ENABLE_EVENT_LOG_DB=false

# [OPTIONAL] Pokazuje przyciski logowania Google/Apple na ekranie logowania. Default false (magic-link = jedyna sciezka). Inlined (NEXT_PUBLIC_, build-time). Flip true DOPIERO gdy provider-creds skonfigurowane w backendzie (GOOGLE_CLIENT_ID/SECRET, APPLE_*) + deep-link cutover gotowy; potem visual-QA przyciskow.
NEXT_PUBLIC_OAUTH_ENABLED=true

# [OPTIONAL] Opcjonalna wartosc dla uspionej bramki platformy (platform.config.ts, GATE_ENABLED=false obecnie). Fallback ''. Inlined (NEXT_PUBLIC_, build-time) = publiczna. Zostaw PUSTA dopoki gate wylaczony.
NEXT_PUBLIC_PLATFORM_GATE_BYPASS=

# --- Internal secrets (server-only, NIE inlined) ---

# [OPTIONAL] S2S sekret do POST /api/v1/internal/track-crawler (AI-crawler analytics). MUSI == INTERNAL_SHARED_SECRET na web-1. Pusty => tracking wylaczony (by design w dev). Shape: <64-hex-secret>.
# Uzycie: proxy.ts wysyla fire-and-forget tracking dla trafien /llms.txt, /sitemap*.xml, /robots.txt.
# PROD: realny 64-hex, IDENTYCZNY z web-1.
INTERNAL_SHARED_SECRET=

# [OPTIONAL] Public store URLs dla /get-app (kernel platform.config.ts -> STORE_URLS). Puste => przyciski "coming soon" (app jeszcze nieopublikowana). Shape: pelny https URL.
# Po publikacji: wklej URL (per env) i zredeployuj, a przyciski aktywuja sie automatycznie bez zmian w kodzie. Detekcja iOS/Android wybiera wlasciwy store.
NEXT_PUBLIC_STORE_URL_APP_STORE=
NEXT_PUBLIC_STORE_URL_GOOGLE_PLAY=

# --- IP / Proxy trust (server-only, Edge proxy) ---

# [OPTIONAL] Ktoremu edge-headerowi ufac przy ekstrakcji IP klienta (analytics, proxy.ts getTrustedEdgeHeaderName). Brak => null (no trusted edge). Shape: enum cloudflare|vercel lub pusty.
# (newVarsToAdd: uzyta w proxy.ts, wczesniej nieobecna w plikach .env.)
# PROD: ustaw zgodnie z hostingiem edge (np. vercel na Vercel, cloudflare za CF).
TRUSTED_EDGE=

# [OPTIONAL] Glebokosc zaufanego lancucha x-forwarded-for (proxy.ts getTrustedProxyDepthOrNull). Brak/0 => brak zaufania do XFF. Shape: number >= 1 lub pusty.
# (newVarsToAdd: uzyta w proxy.ts, wczesniej nieobecna w plikach .env.)
# PROD: ustaw liczbe zaufanych proxy przed app (np. 1 za pojedynczym LB).
TRUSTED_PROXY_DEPTH=

# --- Analytics (public, consent-gated, dormant gdy puste) ---
# Wszystkie BUILD-TIME inlined (NEXT_PUBLIC_) => realne ID musza byc obecne PRZY BUILDZIE prod,
# inaczej narzedzie jest cicho wylaczone bez sladu w configu wdrozenia. Owner dostarcza pre-launch.
# Ladowanie dodatkowo consent-gated (cookie consent) — pusty = narzedzie nieladowane.

# [OPTIONAL] PostHog project API key (public phc_...). PRIMARY product analytics. Pusty => PostHog nie inicjalizuje sie. Shape: phc_...
# PROD: realny phc_... w build env.
NEXT_PUBLIC_POSTHOG_KEY=
# [OPTIONAL] Same-origin reverse-proxy PostHog. Fallback '/ingest'. Zmieniaj tylko razem z rewrites w next.config.mjs.
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# [OPTIONAL] Google Tag Manager container. Fallback ''. Pusty => GTM nie ladowany. Shape: GTM-XXXXXXX.
# PROD: realny GTM-... (jesli GTM ustawiony, zarzadza GA4 — patrz nizej).
NEXT_PUBLIC_GTM_ID=

# [OPTIONAL] GA4 (alternatywa do GTM-managed). Ladowany TYLKO gdy GTM pusty. Fallback ''. Shape: G-XXXXXXXXXX.
# PROD: realny G-... (gdy nie uzywasz GTM).
NEXT_PUBLIC_GA4_ID=

# [OPTIONAL] Microsoft Clarity project id. Fallback ''. Pusty => Clarity nie ladowany. Shape: id alfanumeryczny.
# PROD: realny project id z clarity.microsoft.com.
NEXT_PUBLIC_CLARITY_ID=

# [OPTIONAL] Slug zewn. status-page (openstatus.dev), uzyty w StatusPage.tsx (length-check). Pusty => link na /status ukryty. Shape: slug (np. nailfolio).
# Setup: konto na openstatus.dev (free) -> monitor https://nailfolio.app/api/v1/internal/health-public (5 min) -> skopiuj page-slug.
# PROD: realny slug page (Phase 2: ewentualny server-side OPENSTATUS_API_TOKEN do programowego postowania incydentow).
NEXT_PUBLIC_OPENSTATUS_PAGE_ID=

# --- Build tooling (CLI-only, NIE wymagane w runtime .env) ---

# [OPTIONAL] Wlacza @next/bundle-analyzer (next.config.mjs). Ad-hoc, ustawiany inline w komendzie CLI — nie potrzebny na stale w .env. Shape: boolean-ish true.
# ANALYZE=true
