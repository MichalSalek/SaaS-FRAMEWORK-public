{
  "name": "main",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "development": "npx --yes dotenv-run-script .env.development --",
    "staging": "npx --yes dotenv-run-script .env.production.local --",
    "preview": "npx --yes dotenv-run-script .env.preview --",
    "production": "npx --yes dotenv-run-script .env.production --",
    "dev": "next dev",
    "dev:gen-openapi": "tsx scripts/gen-openapi.ts",
    "pre:build": "rm -rf ./.next ./out && npm run lint",
    "build:development": "npm run pre:build && npm run development build:next",
    "build:staging": "npm run pre:build && npm run staging build:next",
    "build:preview": "npm run pre:build && npm run preview build:next",
    "build:production": "npm run pre:build && npm run production build:next",
    "build:next": "node scripts/build-next.mjs",
    "start": "next start",
    "start:standalone:noenv": "PORT=${PORT:-3000} sh -lc \"APP_NAME=\\$npm_package_name; if [ -f .next/standalone/server.js ]; then exec node .next/standalone/server.js; else exec node .next/standalone/\\$APP_NAME/server.js; fi\"",
    "start:standalone:staging": "npm run staging start:standalone:noenv",
    "start:standalone:production": "npm run production start:standalone:noenv",
    "lint": "eslint --max-warnings 0 --fix .",
    "lint:check": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:llms-md": "node scripts/generate-llms-md.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "test": "npm run lint:check && npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.2",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@tanstack/react-query": "^5.90.21",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "dotenv-run-script": "^0.4",
    "gray-matter": "^4.0.3",
    "jsqr": "^1.4.0",
    "next": "16.3.8",
    "next-intl": "^4",
    "next-mdx-remote": "^6.0.0",
    "posthog-js": "^1.395.0",
    "posthog-node": "^5.39.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "optionalDependencies": {
    "@vercel/functions": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^16.2.6",
    "@next/eslint-plugin-next": "16.3.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "knip": "^6.16.1",
    "madge": "^8.0.0",
    "msw": "^2.11.5",
    "prettier": "^3.9.7",
    "sass": "^1.104.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.53.1",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "fast-glob": "npm:tinyglobby@^0.2.17",
    "sharp": "^0.35.5",
    "postcss": "^8.5.18",
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4"
    },
    "source-map-js": "^1.2.2"
  }
}
