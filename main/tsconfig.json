{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "checkJs": false,
    "jsx": "react-jsx",
    "tsBuildInfoFile": ".next/cache/tsbuildinfo.json",
    "paths": {
      "@kernel/*": ["./src/READONLY-shared-kernel/*"]
    },
    "types": [],
    "composite": false,
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["node_modules", ".next", ".open-next", "dist", "build"]
}
