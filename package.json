    "test:db:reset:dev": "docker exec web-1-dev sh -c 'cd /app && npx prisma db push --accept-data-loss --force-reset --schema=./src/prisma/schema.prisma --url=$DATABASE_URL' && docker restart web-1-dev && echo 'Waiting for seed...' && sleep 15 && docker logs web-1-dev --tail 5 | grep -q 'Initialization complete' && echo '✅ Database reset complete with seed'",
    "test:verify-seed": "docker logs web-1-dev --tail 30 | grep 'Permissions' || echo '❌ Seed not found - restart container'",
    "test:get-stylist-token": "curl -s -i -X POST 'http://localhost:3001/api/auth/dev-login' -H 'content-type: application/json' -H 'Origin: http://localhost:3000' --data '{\"email\":\"test-stylist@example.com\"}' 2>&1 | grep -i '^authorization:' | awk '{print $2}' | tr -d '\\r' || echo '❌ Failed to get token'",
    "test:get-admin-token": "curl -s -i -X POST 'http://localhost:3001/api/auth/dev-login' -H 'content-type: application/json' -H 'Origin: http://localhost:3000' --data '{\"email\":\"admin@example.com\"}' 2>&1 | grep -i '^authorization:' | awk '{print $2}' | tr -d '\\r' || echo '❌ Failed to get token'",
