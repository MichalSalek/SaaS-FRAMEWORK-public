# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (contain secrets) — gitignored, realne sekrety OK.
#   .env.development = DEVELOPMENT  |  .env.production = PRODUCTION (prawdziwy prod)
#   .env.production.local = STAGING (!! NODE_ENV_MANUAL=STAGING, NIE produkcja)
.env.development
.env.production
.env.production.local
# TRACKED (bez realnych sekretow; preview-secrety wstrzykuje panel Render):
#   .env.preview = PREVIEW  ·  .env.example = SZABLON
# Pelna konwencja + decyzje: docs/DOMAIN/ENVIRONMENT_REFERENCE.md + naglowek kazdego pliku .env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

.open-next

*.Identifier
.idea


.env.preview

# Zrzuty konsoli z audytow — regenerowane przy KAZDYM przebiegu (patrz ten sam
# wpis w main/.gitignore). Brudzily drzewo po kazdym `npm run audit:all`.
.audit-logs/
