# =============================================================================
# web-1 (backend — Next.js API routes + Prisma)
# >>> TEN PLIK = SZABLON (.env.example) | TRACKED w git | placeholdery, NIGDY realnych sekretow <<<
#
# To jest SSOT struktury env (lista zmiennych + ksztalt). Kopiuj do realnych plikow i wypelnij.
#
# KONWENCJA PLIKOW ENV — czytaj ZANIM cokolwiek zmienisz (AI i ludzie):
#   .env.development       -> DEVELOPMENT (localhost)     | gitignored | realne sekrety OK
#   .env.preview           -> PREVIEW (Render preview)    | TRACKED    | bez sekretow (panel Render)
#   .env.production        -> PRODUCTION (PRAWDZIWY prod) | gitignored | realne sekrety OK
#   .env.production.local  -> STAGING (!!)                | gitignored | realne sekrety OK
#   .env.example           -> SZABLON (placeholdery)      | TRACKED    | NIGDY realnych sekretow
#
# !!! .env.production.local TO STAGING (NODE_ENV_MANUAL=STAGING), NIE produkcja.
#     Plik produkcyjny = .env.production. Sufiks ".local" = top-priority dotenv + gitignored.
#
# Walidacja web-1 = env-schema.ts (SSOT). required:'always' = krytyczne (DB/auth/URL),
#   'prod' = wymagane tylko na PRODUCTION (Mailgun, INTERNAL_SHARED_SECRET, admin email),
#   reszta = optional (feature-flag obecnoscia). DEVELOPMENT/STAGING = soft (warn);
#   PRODUCTION/PREVIEW = hard (process.exit(1)). Per-linijkowe [REQUIRED]/[OPTIONAL] nizej
#   sa ORIENTACYJNE — autorytet to env-schema.ts. Rejestr+decyzje: docs/DOMAIN/ENVIRONMENT_REFERENCE.md
# =============================================================================

# --- Environment / Runtime flags ---

# [REQUIRED] Reczny przelacznik trybu app (Next NODE_ENV nie wystarcza — staging uzywa NODE_ENV=production). Steruje soft/hard validateEnv. Shape: enum DEVELOPMENT|STAGING|PREVIEW|PRODUCTION.
NODE_ENV_MANUAL=DEVELOPMENT
# [OPTIONAL] Verbose backend debug logging. Shape: boolean (default false).
INIT_BACKEND_DEBUG_MODE=false
# [OPTIONAL] Debug logow DB/Prisma. Shape: boolean (default false).
INIT_BACKEND_DEBUG_DB_MODE=false
# [OPTIONAL] W dev: zapis logow do app-logs DB (domyslnie off w dev). Shape: boolean (default false).
ENABLE_APP_LOGS_DB=false
# [OPTIONAL] Gate auto-smoke-testow 5s po starcie + gate seedu test-userow. Shape: boolean (default false).
RUN_SMOKE_TESTS_ON_STARTUP=true
# DEAD/build-time: czytane przez `next` CLI przy build/start (0 uzyc w src). Zostaje, bo wycisza telemetrie Next.js. Shape: boolean (1).
NEXT_TELEMETRY_DISABLED=1

# Pre-launch SEO gate. Bezpieczny default: brak/puste/false => site-wide noindex,nofollow.
# Launch: ustaw SEO_INDEXING_ENABLED=true (lub 1) i przebuduj/redeploy.
SEO_INDEXING_ENABLED=false

# --- Database ---

# [REQUIRED] Glowna baza (Neon/Postgres) przez Prisma. Shape: URL postgresql://USER:PASS@HOST/DB?sslmode=require.
# Na Neon uzyj POOLED endpointu (host z sufiksem `-pooler`) — runtime (PrismaPg adapter) trzyma pool.
DATABASE_URL=postgresql://USER:PASS@HOST-pooler/DB
# [OPTIONAL] Neon DIRECT (unpooled) endpoint — TYLKO dla Prisma CLI (migrate deploy/generate).
# = ten sam URL co DATABASE_URL, ale host BEZ `-pooler`. Advisory lock migracji nad PgBouncer
# poolerem leakuje (osierocony backend trzyma lock -> P1002 timeout na Render build), wiec CLI
# idzie direct. Jesli pusty, prisma.config.mjs derywuje go automatycznie zdejmujac `-pooler`
# z DATABASE_URL — ta zmienna to jawny override na wypadek nietypowego hosta.
DIRECT_DATABASE_URL=postgresql://USER:PASS@HOST/DB
# [REQUIRED] Osobna baza Event Log Store (Neon) — logi/eventy. Shape: URL postgresql://USER:PASS@HOST/DB?sslmode=require.
DATABASE_APP_LOGS_URL=postgresql://USER:PASS@HOST/DB

# --- Master Admin ---

# [REQUIRED] Allow-lista master adminow (comma-separated); stempel roli MASTER_ADMIN. Shape: string (CSV emaili). PROD: realne adresy adminow.
MASTER_ADMIN_EMAIL=

# --- Public URLs (Frontend Connection) ---

# [REQUIRED] Domena frontendu do budowy absolutnych URLi (consumer ma wlasny fallback nailfolio.app). Shape: string/host (w dev moze byc CSV hostow). PROD: nailfolio.app.
FRONTEND_PUBLIC_DOMAIN=localhost
# [REQUIRED] Port frontendu; puste w prod => bez :port (ale puste tripuje validateEnv). Shape: port number lub puste. PROD: pozostaw puste (443 za LB).
FRONTEND_PUBLIC_PORT=3000
# [REQUIRED] Kanoniczny URL FRONTU (trustedOrigins/CSRF + Stripe success/cancel/return na /app + appInfo). Shape: URL. PROD: https://nailfolio.app. (Backend = BETTER_AUTH_URL.) Dev: URL frontu.
PUBLIC_URL=http://localhost:3000
# [OPTIONAL] Cutover switch for native deep-link login (magic-link + OAuth). Default false. Shape: bool. PROD: ustaw true DOPIERO gdy nailfolio.app jest live + /.well-known/ association reachable + wrapper PROD_URL zsynchronizowany. Gdy true: magic-link mail -> origin frontendu (Universal/App Links), brak click-tracking, natywny OAuth wraca przez nailfolio:// scheme.
NATIVE_DEEPLINK_ENABLED=false

# --- Auth / Session (Better Auth) ---

# [REQUIRED] Sekret podpisu sesji/tokenow Better Auth. Shape: secret base64 ~44 char. PROD: wygeneruj `openssl rand -base64 32`.
BETTER_AUTH_SECRET=<32-char-secret>
# [REQUIRED] Base URL instancji auth. Shape: URL. PROD: https://api.nailfolio.app.
BETTER_AUTH_URL=http://localhost:3001
# [REQUIRED] Podpis HMAC tokenow unsubscribe w mailach. Shape: secret base64 ~44 char. PROD: `openssl rand -base64 32`.
EMAIL_UNSUBSCRIBE_SECRET=<32-char-secret>
# [REQUIRED] HMAC opaque backup-tokenow impersonacji admina (D23); consumer rzuca throw na prod gdy brak. Shape: secret base64 ~44 char. PROD: `openssl rand -base64 32`.
IMPERSONATION_HMAC_SECRET=<32-char-secret>

# --- OAuth Providers (Google + Apple) ---
# Uwaga: GOOGLE_* sa w RAW_VARS (fail-loud) — puste = process.exit(1) na PROD/PREVIEW,
#   mimo ze provider sam nie ma guardu. APPLE_* (ID/TEAM/KEY/PRIVATE) sa feature-flag w
#   kodzie (APPLE_ENABLED), ale tez w RAW_VARS — puste tripuja validateEnv (na prod de
#   facto wymagane). APPLE_APP_BUNDLE_IDENTIFIER uzywany niezaleznie.

# [REQUIRED] Google OAuth client id. Shape: string (...apps.googleusercontent.com). PROD: realny client id.
GOOGLE_CLIENT_ID=
# [REQUIRED] Google OAuth secret. Shape: secret (GOCSPX-...). PROD: realny secret.
GOOGLE_CLIENT_SECRET=
# [REQUIRED] Bundle id dla Apple Sign-In (native). Shape: string reverse-DNS. PROD: com.nailfolio.app.
APPLE_APP_BUNDLE_IDENTIFIER=com.nailfolio.app
# [OPTIONAL] Apple OAuth services id; pusty = Apple provider off (graceful, ale tripuje validateEnv na prod). Shape: string.
APPLE_ID=
# [OPTIONAL] Apple Team ID. Shape: string (10-znakowy).
APPLE_TEAM_ID=
# [OPTIONAL] Klucz prywatny do podpisu Apple client_secret JWT. Shape: secret PEM (\n-escaped).
APPLE_PRIVATE_KEY=
# [OPTIONAL] Apple Key ID. Shape: string (10-znakowy).
APPLE_KEY_ID=

# --- Email (Mailgun) ---
# Uwaga: caly blok jest fail-loud w validateEnv (RAW_VARS bez fallbacku) — puste klucze
#   = process.exit(1) na PROD/PREVIEW, mimo ze send ma guard if(!apiKey). MAILGUN_SMTP_*
#   to transport fallback (SMTP).

# [REQUIRED] Klucz API Mailgun (HTTP send). Shape: secret (api key). PROD: realny klucz.
MAILGUN_API_KEY=
# [REQUIRED] Base URL API Mailgun (region EU). Shape: URL. PROD: https://api.eu.mailgun.net.
MAILGUN_API_BASE_URL=https://api.eu.mailgun.net
# [REQUIRED] Domena nadawcza Mailgun. Shape: string (domena maila). PROD: mg.nailfolio.app.
MAILGUN_DOMAIN=
# [REQUIRED] Adres nadawcy (From). Shape: email. PROD: no-reply@nailfolio.app.
FROM_EMAIL=
# [REQUIRED] Host SMTP (fallback transport). Shape: host. PROD: smtp.eu.mailgun.org.
MAILGUN_SMTP_HOST=smtp.eu.mailgun.org
# [REQUIRED] Port SMTP. Shape: port number (587/465).
MAILGUN_SMTP_PORT=587
# [REQUIRED] Login SMTP. Shape: string (smtp user). PROD: realny login.
MAILGUN_SMTP_LOGIN=
# [REQUIRED] Haslo SMTP. Shape: secret (smtp pass). PROD: realne haslo.
MAILGUN_SMTP_PASSWORD=

# --- Email (Resend) - docelowy provider transakcyjny ---
# OBECNOSC RESEND_API_KEY = Resend primary (feature-flag by presence, jak Stripe/Apple); pusty = Mailgun.
# From hardcoded noreply@nailfolio.app w adapterze (zero osobnej zmiennej From).
# RESEND_API_KEY: klucz API Resend (re_...). Placeholder w example; realny w .env.development
# (gitignored) oraz wstrzykiwany w prod/stg. Migracja kodu Mailgun->Resend = osobny krok.
RESEND_API_KEY=

# [OPTIONAL] Resend Audiences (lista broadcastowa newslettera). PELNY klucz (contacts+broadcasts),
# ODREBNY od send-only RESEND_API_KEY (least-privilege: hot send-path zostaje send-only). Oba obecne
# = potwierdzeni subskrybenci double-opt-in synchronizowani do Audience. Puste = newsletter dziala
# (DB = SSOT zgody RODO), po prostu bez syncu do listy broadcastowej.
RESEND_MARKETING_API_KEY=
RESEND_AUDIENCE_ID=

# [OPTIONAL] Cloudflare Turnstile (anty-bot na publicznym formularzu kontaktowym).
# Feature-flag BY PRESENCE: sekret obecny = server-side weryfikacja tokenu Turnstile
# WYMAGANA na POST /public/contact-form (brak/zly token => 403, FAIL-CLOSED przy awarii
# CF — patrz DECISION w application/security/turnstile.verify.ts); pusty = weryfikacja
# OFF (dev/staging dziala bez widgetu). Realny sekret TYLKO na Render prod (nie w repo).
TURNSTILE_SECRET_KEY=

# [OPTIONAL] Dev-only straznik dziennej quoty Mailgun. INERT poza
#   NODE_ENV_MANUAL=DEVELOPMENT (sink sprawdza IS_DEVELOPMENT_ENV przed odczytem flag).
#   Ile realnych wyslan/proces zanim reszta jest stubowana (canary; default 1, 0=stubuj
#   wszystko). Shape: int >=0 (ujemne -> default). Konsument: email-dev-sink.ts.
DEV_EMAIL_LIVE_BUDGET=1
# [OPTIONAL] Dev-only: true = omin stub, wysylaj realnie w dev (debug dostarczania maili).
#   INERT poza DEVELOPMENT. Shape: boolean (default false).
DEV_EMAIL_FORCE_LIVE=false

# --- Payments (Stripe) ---
# Uwaga: STRIPE_SECRET_KEY i STRIPE_WEBHOOK_SECRET sa fail-loud w validateEnv (puste =
#   process.exit(1) na PROD/PREVIEW), choc consumer ma graceful guard if(!...) (Stripe off).

# [REQUIRED do checkoutu] Klucz API Stripe.
#   Shape: secret sk_live_xxx z Dashboard. Puste = Stripe off (optional w env-schema).
STRIPE_SECRET_KEY=sk_live_xxx
# [REQUIRED do checkoutu] Weryfikacja podpisu webhookow Stripe. Shape: secret whsec_xxx z Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# [OPTIONAL] Return URL z Stripe Customer Portal. Shape: URL (default http://localhost:3000/app). PROD: https://nailfolio.app/app.
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/app
# [OPTIONAL] Id konfiguracji Customer Portal; pusty dozwolony. Shape: string bpc_xxx.
STRIPE_PORTAL_CONFIGURATION_ID=
# [QA only] Opcjonalne ID kuponu stosowanego przy checkoucie na czas QA. Puste = normalna cena.
#   ID ze Stripe Dashboard.
STRIPE_TEST_COUPON_ID=

# --- Media (Cloudinary) — backend creds (optional w env-schema) ---
# DECISION (nie usuwaj tego komentarza):
# Upload + wyswietlanie obrazow idzie BEZPOSREDNIO frontend -> Cloudinary (publiczny
# cloud_name = main NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<cloud-name>), NIE przez backend.
# Te 3 zmienne (cloud_name/api_key/secret) gatuja TYLKO best-effort orphan-cleanup
# (cleanupCloudinaryAsset[s] po skasowaniu rekordu; fire-and-forget, bledy logowane NIE
# rzucane). Bez nich cleanup jest pomijany. Wszystkie 3 = 'optional' w env-schema ->
# NIGDY nie blokuja bootu. Serwerowy cleanup wymaga CALEJ trojki (z dashboardu
# Cloudinary); sam cloud_name bez auth nie zadziala.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

# --- Internal secrets (S2S) ---

# [OPTIONAL] Shared secret S2S dla /internal/track-crawler + drugi zamek dev-login; NIE w RAW_VARS (nie tripuje validateEnv), wlasna logika fail-closed (prod bez = tracking off / dev-login 404 mask). Ustaw TEN SAM wartosc na froncie (main/.env). Shape: secret hex 64 char. PROD: `openssl rand -hex 32`.
INTERNAL_SHARED_SECRET=

# --- i18n / Locale ---

# [OPTIONAL] Domyslny jezyk. Shape: enum pl|en|de (default pl).
DEFAULT_LOCALE=pl
# [OPTIONAL] Strefa czasowa. Shape: string IANA TZ (default Europe/Warsaw).
TIMEZONE=Europe/Warsaw

# --- IP / Proxy trust ---
# KRYTYCZNE (security): po hardeningu IP-trust (DECISION-block w trust-aware-ip.ts)
#   nieskonfigurowany deployment kotwiczy IP na socket-peer (niespoofowalne). Za
#   load-balancerem ustaw oba klucze ponizej, zeby limity liczyly sie per klient.

# [OPTIONAL] Liczba zaufanych proxy w lancuchu XFF; >=1 ufa N ostatnim hopom. UNSET = secure-by-default (anchor na socket peer, ignoruje XFF). Shape: number (>=1). PROD: =2 dla Cloudflare->Render (bez tego rate-limit/dedup w jednym buckecie).
TRUSTED_PROXY_DEPTH=
# [OPTIONAL] Nazwa zaufanego edge => ufa cf-connecting-ip / x-vercel-forwarded-for. UNSET = off (secure default). Shape: enum cloudflare|vercel.
TRUSTED_EDGE=

# --- PostHog Error Tracking (server-side) ---
# [OPTIONAL] Publiczny phc_ ingestion key projektu PostHog — TEN SAM co main NEXT_PUBLIC_POSTHOG_KEY (jeden projekt). Obecny + PRODUCTION => bledy/warny backendu (reportIssueBackend) ida do PostHog Error Tracking; pusty => tylko lokalny EventLog (SSOT logow zostaje). NIE sekret. Shape: phc_...
POSTHOG_PROJECT_KEY=
# [OPTIONAL] Bezposredni EU ingest host (nie /ingest proxy — to rewrite Next tylko dla przegladarki). Default https://eu.i.posthog.com gdy pusty. Shape: https URL.
POSTHOG_HOST=

# --- Better Stack + Neon monitoring (control plane; no SQL keepalive) ---
# [OPTIONAL] Secret Better Stack heartbeat URL for the hourly compute-budget check.
# Empty = quota monitoring off. This control-plane check never issues SQL.
BETTERSTACK_NEON_QUOTA_HEARTBEAT_URL=
# [OPTIONAL] Neon organization API key scoped ONLY to the production project.
# Used by the hourly quota monitor; never use a founder/personal key in runtime.
NEON_MONITORING_API_KEY=
# [OPTIONAL] Neon project ID paired with NEON_MONITORING_API_KEY.
NEON_MONITORING_PROJECT_ID=
# [OPTIONAL] Operator budget in CU-hours; default 100. Monitor fails at 85%.
NEON_COMPUTE_BUDGET_CU_HOURS=100
