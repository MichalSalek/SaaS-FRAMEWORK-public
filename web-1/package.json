{
  "name": "web-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "pre:build": "rm -rf ./.next && npm run lint:check",
    "build:development": "npm run pre:build && npm run development build:next",
    "build:staging": "npm run pre:build && npm run staging build:next",
    "build:preview": "npm run pre:build && npm run preview build:next",
    "build:production": "npm run pre:build && npm run production build:next",
    "build:next": "next build --webpack",
    "start:standalone:noenv": "echo $FRONTEND_PUBLIC_DOMAIN && NEXT_MANUAL_SIG_HANDLE=true PORT=${PORT:-3000} sh -lc \"APP_NAME=\\$npm_package_name; if [ -f .next/standalone/server.js ]; then exec node .next/standalone/server.js; else exec node .next/standalone/\\$APP_NAME/server.js; fi\"",
    "start:standalone:staging": "npm run staging start:standalone:noenv",
    "start": "NEXT_MANUAL_SIG_HANDLE=true PORT=$PORT next start",
    "lint": "eslint --max-warnings 0 --fix .",
    "lint:check": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo 'No default test script by design - run npm run test:unit (Vitest) or npm run typecheck' && exit 1",
    "development": "npx --yes dotenv-run-script .env.development --",
    "staging": "npx --yes dotenv-run-script .env.production.local --",
    "preview": "npx --yes dotenv-run-script .env.preview --",
    "production": "npx --yes dotenv-run-script .env.production --",
    "db:push:all": "npm run db:push:safe",
    "db:push:staging": "npm run staging db:push:all",
    "db:push:preview": "npm run preview db:push:all",
    "db:push:production": "npm run production db:push:all",
    "db:push:logs:global": "npm run production db:push:safe:logs",
    "db:pull": "npx prisma db pull --schema=./src/prisma/schema.prisma",
    "db:push:safe": "npx prisma db push --schema=./src/prisma/schema.prisma",
    "db:migrate:dev": "npx prisma migrate dev --schema=./src/prisma/schema.prisma",
    "db:migrate:resolve": "npx prisma migrate resolve --schema=./src/prisma/schema.prisma --applied",
    "db:migrate:dev:create": "npx prisma migrate dev --create-only --schema=./src/prisma/schema.prisma --name",
    "db:migrate:prod": "npx prisma migrate deploy --schema=./src/prisma/schema.prisma",
    "db:gen": "npx prisma generate --schema=./src/prisma/schema.prisma",
    "db:gen:watch": "npx prisma generate --watch --schema=./src/prisma/schema.prisma",
    "db:reset": "npx prisma migrate reset --schema=./src/prisma/schema.prisma --force",
    "prisma:format": "npx prisma format --schema=./src/prisma/schema.prisma",
    "db:create:baseline": "npx prisma migrate diff --from-empty --to-schema ./src/prisma/schema.prisma --script -o ./src/prisma/migrations/0_current_baseline/migration.sql && node scripts/prepend-baseline-extensions.mjs",
    "db:apply:baseline": "npx prisma migrate resolve --applied 0_current_baseline --schema=./src/prisma/schema.prisma",
    "db:status": "npx prisma migrate status --schema=./src/prisma/schema.prisma",
    "db:host": "node scripts/dev-db-host.mjs",
    "db:status:dev": "node scripts/dev-db-host.mjs db:status",
    "db:status:staging": "npm run staging db:status",
    "db:status:preview": "npm run preview db:status",
    "db:status:production": "npm run production db:status",
    "db:clean-qa": "bash ../scripts/db/clean-qa-artifacts.sh",
    "db:studio": "npx prisma studio --schema=./src/prisma/schema.prisma --port 5555",
    "db:studio:dev": "node scripts/dev-db-host.mjs db:studio",
    "db:push:dev": "node scripts/dev-db-host.mjs db:push:safe",
    "db:apply:baseline:dev": "node scripts/dev-db-host.mjs db:apply:baseline",
    "db:migrate:dev:logs": "npx prisma migrate dev --schema=./src/prisma-app-logs/schema.prisma",
    "db:migrate:resolve:logs": "npx prisma migrate resolve --schema=./src/prisma-app-logs/schema.prisma --applied",
    "db:migrate:dev:create:logs": "npx prisma migrate dev --create-only --schema=./src/prisma-app-logs/schema.prisma --name",
    "db:migrate:prod:logs": "npx prisma migrate deploy --schema=./src/prisma-app-logs/schema.prisma",
    "db:push:safe:logs": "npx prisma db push --schema=./src/prisma-app-logs/schema.prisma",
    "db:gen:logs": "npx prisma generate --schema=./src/prisma-app-logs/schema.prisma",
    "db:reset:logs": "npx prisma migrate reset --schema=./src/prisma-app-logs/schema.prisma --force",
    "db:create:baseline:logs": "npx prisma migrate diff --from-empty --to-schema ./src/prisma-app-logs/schema.prisma --script -o ./src/prisma-app-logs/migrations/0_current_baseline/migration.sql",
    "db:apply:baseline:logs": "npx prisma migrate resolve --applied 0_current_baseline --schema=./src/prisma-app-logs/schema.prisma",
    "db:status:logs": "npx prisma migrate status --schema=./src/prisma-app-logs/schema.prisma",
    "db:studio:logs": "npx prisma studio --schema=./src/prisma-app-logs/schema.prisma --port 5556",
    "docker:dev:exec": "docker compose -f ../docker-compose.dev.yml exec -T web-1-dev",
    "docker:dev:exec:tty": "docker compose -f ../docker-compose.dev.yml exec web-1-dev",
    "db:push:docker": "npm run docker:dev:exec -- npm run db:push:safe",
    "db:migrate:dev:docker": "npm run docker:dev:exec -- npm run db:migrate:dev",
    "db:status:docker": "npm run docker:dev:exec -- npm run db:status",
    "db:gen:docker": "npm run docker:dev:exec -- npm run db:gen",
    "db:studio:docker": "npm run docker:dev:exec:tty -- npm run db:studio",
    "db:backfill:cached-counts": "tsx scripts/backfill-cached-counts.ts",
    "db:backfill:asset-public-id": "tsx scripts/backfill-asset-public-id.ts",
    "db:backfill:legacy-email-verified": "tsx scripts/backfill-legacy-email-verified.ts",
    "db:seed:demo": "tsx scripts/seed-demo-content.ts",
    "db:seed:permissions": "tsx scripts/reseed-permissions.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@msalek/utils": "2.6.6",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "@prisma/config": "^7",
    "better-auth": "^1.7.5",
    "cloudinary": "^2",
    "dotenv-run-script": "^0.4",
    "fast-geoip": "^1.1.88",
    "form-data": "^4.0.5",
    "jose": "^6.2.2",
    "mailgun.js": "^12.7.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.9",
    "pg": "^8",
    "posthog-node": "^5.39.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.14.0",
    "stripe": "^20.1.2",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@vercel/functions": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.5",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^24",
    "@types/nodemailer": "^7",
    "@types/pg": "^8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "baseline-browser-mapping": "^2.11.24",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "madge": "^8.0.0",
    "node-mocks-http": "^1.18.1",
    "prettier": "^3.9.7",
    "prisma": "^7",
    "ts-prune": "^0.10.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "fast-glob": "npm:tinyglobby@^0.2.17",
    "postcss": "^8.5.18",
    "sharp": "^0.35.5",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.4",
    "source-map-js": "^1.2.2"
  }
}
