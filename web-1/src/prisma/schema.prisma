  id                Int                  @id @default(autoincrement())
  newsletter_id     String
  // DECISION [newsletterconsent-restrict]: brak onDelete => Restrict CELOWO; append-only consent audit (RODO Art.30), GDPR=anonimizacja nie delete -> docs/DOMAIN/SCHEMA_DECISIONS.md#newsletterconsent-restrict
  newsletter        NewsletterSubscriber @relation(fields: [newsletter_id], references: [id])
  action            String // NEWSLETTER_CONSENT_ACTION: "SUBSCRIBE" | "UNSUBSCRIBE"
  consent_timestamp DateTime             @default(now())
  ip_address        String?
  user_agent        String?

  @@index([newsletter_id, consent_timestamp(sort: Desc)])
