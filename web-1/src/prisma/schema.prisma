// Session Container — multi-photo session inspiration container
// Lifecycle: DRAFT → READY → SHARED → ACTIVE → EXPIRED/CLOSED
enum SessionContainerLifecycleState {
  DRAFT
  READY
  SHARED
  ACTIVE
  EXPIRED
  CLOSED
}

model SessionContainer {
  id                 String                         @id @default(cuid())
  client_account_id  String
  stylist_account_id String?
  name               String?                        @db.VarChar(100)
  lifecycle_state    SessionContainerLifecycleState @default(DRAFT)
  stylist_note       String?                        @db.VarChar(500)
  client_note        String?                        @db.VarChar(500)
  shared_at          DateTime?
  expires_at         DateTime?
  closed_at          DateTime?
  created_at         DateTime                       @default(now())
  updated_at         DateTime                       @updatedAt

  client_account  ClientAccount           @relation(fields: [client_account_id], references: [client_account_id], onDelete: Cascade)
  stylist_account StylistAccount?         @relation(fields: [stylist_account_id], references: [account_id], onDelete: SetNull)
  photos          SessionContainerPhoto[]
  visit_record    VisitRecord?            @relation("SessionVisit")

  // DECISION (nie usuwaj tego komentarza): partial-unique 'session_container_active_pair_uq'
  // jest nieekspresowalny w Prisma schema (filtered WHERE lifecycle_state NOT IN (CLOSED,EXPIRED)
  // AND stylist_account_id IS NOT NULL) → tworzony idempotentnie raw-SQL na starcie w
  // web-1/src/application/startup/ensure-db-indexes.ts (wpiety w instrumentation.ts krok 8.55).
  // db push go NIE zarzadza. Catch P2002 'active_pair' (create + add-photo operations) polega
  // na tym indeksie jako strukturalnym backstopie invariantu SC-2 (max 1 niesterminalna sesja
  // per para client/stylist) + per-client cap.

  @@index([client_account_id, lifecycle_state])
  @@index([client_account_id, shared_at])
  @@index([stylist_account_id, lifecycle_state])
  @@index([expires_at])
}

model SessionContainerPhoto {
  id                String   @id @default(cuid())
  session_id        String
  gallery_record_id String
  position          Int      @default(0)
  created_at        DateTime @default(now())

  session        SessionContainer @relation(fields: [session_id], references: [id], onDelete: Cascade)
  gallery_record GalleryRecord    @relation(fields: [gallery_record_id], references: [gallery_record_id], onDelete: Cascade)

  @@unique([session_id, gallery_record_id])
  // DD2-D2 (run 24): enforce dense ordering within a session — race-condition guard.
  // `addPhotoToSessionContainer_IO` reads max(position) then inserts; two concurrent inserts
  // could pick the same nextPosition. Unique forces P2002 → retry with incremented position
  // (max 5 retries, see session-container-commands.operations.ts).
  // Implicitly covers @@index([session_id, position]) — Postgres uses the unique B-tree
  // for both ORDER BY position queries and uniqueness checks. No separate index needed.
  @@unique([session_id, position])
  @@index([gallery_record_id])
}

model VisitRecord {
  id                 String            @id @default(cuid())
  client_user_id     String
  stylist_account_id String
  visit_date         DateTime          @default(now())
  service_note       String?           @db.VarChar(1000)
  source             VisitRecordSource @default(MANUAL)
  session_id         String?           @unique
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  client_user     User               @relation("ClientVisits", fields: [client_user_id], references: [id], onDelete: Cascade)
  stylist_account StylistAccount     @relation("StylistVisits", fields: [stylist_account_id], references: [account_id], onDelete: Cascade)
  session         SessionContainer?  @relation("SessionVisit", fields: [session_id], references: [id], onDelete: SetNull)
  result_photos   VisitResultPhoto[]

  @@index([stylist_account_id, client_user_id, visit_date(sort: Desc)])
  @@index([client_user_id, visit_date(sort: Desc)])
}

model VisitResultPhoto {
  id                 String   @id @default(cuid())
  visit_record_id    String
  stylist_account_id String
  asset_url          String
  // DECISION [asset-public-id]: identyfikator pliku w chmurze wyprowadzony z adresu przy
  // zapisie; indeks zastepuje skan calej kolumny adresow w bramce wlasnosci pliku.
  // NULL = adresu nie dalo sie rozlozyc -> wiersz ZOSTAJE na wolniejszej sciezce
  // porownania w kodzie (patrz cloudinary-asset.guard.ts). Swiadomie BEZ @unique:
  // pytamy o istnienie, nie o unikalnosc, a ten sam plik moze byc legalnie wskazany
  // przez wiersz historyczny. -> docs/DOMAIN/SCHEMA_DECISIONS.md#asset-public-id
  public_id          String?
  position           Int      @default(0)
  created_at         DateTime @default(now())

  visit_record VisitRecord @relation(fields: [visit_record_id], references: [id], onDelete: Cascade)

  @@unique([visit_record_id, position])
  @@index([public_id])
}

// ─��� Email Dead Letter ──────────────────────────────────────────────────────────

model FailedEmail {
  id          String    @id @default(cuid())
  recipient   String
  template    String
  subject     String
  payload     Json
  error       String
  attempts    Int       @default(3)
  created_at  DateTime  @default(now())
  resolved_at DateTime?
  // DECISION [failedemail-resolved-soft-fk]: resolved_by = soft-FK audit-trail (admin zamykający), append-only > integralność -> docs/DOMAIN/SCHEMA_DECISIONS.md#failedemail-resolved-soft-fk
  resolved_by String?

  @@index([created_at])
  @@index([resolved_at])
  // PLQS C1-5D (2026-05-28): admin lookup / dedup by recipient email address.
  @@index([recipient])
}

// ── Support Messaging ──────────────────────────────────────────────────────────

enum SupportThreadStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum SupportSenderType {
  USER
  SUPPORT
}

// What the request is about, picked by the user instead of typing a subject (S126).
enum SupportThreadCategory {
  QUESTION
  BILLING
  BUG
  IDEA
  ACCOUNT
  OTHER
}

model SupportThread {
  id                String                 @id @default(cuid())
  user_id           String
  // Since S126 derived by the server from the first line of the first message
  // (support-subject.resolver.ts); still NOT NULL and still the title everywhere.
  subject           String
  // DECISION [supportthread-category]: nullable; null = a thread created before categories existed, never backfilled -> docs/DOMAIN/SCHEMA_DECISIONS.md#supportthread-category
  category          SupportThreadCategory?
  status            SupportThreadStatus    @default(OPEN)
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  // DECISION [supportthread-user-last-read-at] (nie usuwaj tego komentarza):
  // The moment the OWNER of the thread last opened it. A thread has an unread
  // reply when a SUPPORT message exists with created_at > user_last_read_at.
  // The default makes every existing and every new thread start as "read", so
  // shipping the marker lights no badge for history. Written ONLY by raw SQL
  // (support-read-marker.operations.ts): a Prisma update would bump
  // @updatedAt, which is the admin's optimistic-concurrency token.
  // -> docs/DOMAIN/SCHEMA_DECISIONS.md#supportthread-user-last-read-at
  user_last_read_at DateTime               @default(now())

  // DECISION [supportthread-soft-fk]: user_id = soft-FK; historia supportu przeżywa hard-delete/MOVE usera -> docs/DOMAIN/SCHEMA_DECISIONS.md#supportthread-soft-fk
  messages SupportMessage[]

  @@index([user_id])
  // PRMA C1-F3 (2026-05-27, HIGH): admin support queue paginates threads filtered by status
  // ordered by id DESC (cuid lexicographic ~= insertion order). Composite removes sort step
  // for the dominant "list OPEN threads, newest first" admin query.
  // DECISION [supportthread-status-index]: standalone [status] usunięty — composite [status, id DESC] = left-prefix -> docs/DOMAIN/SCHEMA_DECISIONS.md#supportthread-status-index
  @@index([status, id(sort: Desc)])
}

model SupportMessage {
  id          String            @id @default(cuid())
  thread_id   String
  sender_type SupportSenderType
  // @db.Text = unbounded long-form (paragraph descriptions, stack traces). Na Postgres
  // bare String i tak mapuje się na TEXT — anotacja dokumentuje intencję, nie zmienia
  // typu (VARCHAR(191) to zachowanie MySQL, nie PG). Walidator CONTENT_MAX=2000 mieści się w TEXT.
  content     String            @db.Text
  created_at  DateTime          @default(now())

  thread SupportThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  // PLQS C1-5D (2026-05-28): message listing always orders by created_at ASC within a thread.
  // Composite eliminates the sort step for getSupportThreadMessages_IO + adminGetThreadMessages_IO.
  @@index([thread_id, created_at(sort: Asc)])
}

// Moderation Strikes — rolling window (365 days).
// Each strike is a time-bounded record. Active = expires_at > now().
// User.moderation_strikes kept for backwards compat (monotonic counter).
model ModerationStrike {
  id         String   @id @default(cuid())
  user_id    String
  // DECISION [moderationstrike-reason-varchar]: VarChar(2000) MUSI = STRIKE_REASON_MAX; węższy => 22001 truncation rollback -> docs/DOMAIN/SCHEMA_DECISIONS.md#moderationstrike-reason-varchar
  reason     String   @db.VarChar(2000)
  issued_at  DateTime @default(now())
  expires_at DateTime
  // DECISION [moderationstrike-issued-by-soft-fk]: issued_by = soft-FK audit-trail (admin nadający strike), append-only > integralność -> docs/DOMAIN/SCHEMA_DECISIONS.md#moderationstrike-issued-by-soft-fk
  issued_by  String

  user User @relation("ModerationStrikeRelation", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at(sort: Desc)])
}
