model ClientStylistPair {
  id                            String        @id @default(cuid())
  client_user_id                String
  stylist_account_id            String
  paired_at                     DateTime      @default(now())
  // DECISION [clientstylistpair-soft-ref]: soft-reference audyt-only do PairingSession.id, gwarancja app-level (0 orphanów) -> docs/DOMAIN/SCHEMA_DECISIONS.md#clientstylistpair-soft-ref
  paired_via_pairing_session_id String?
  status                        PairingStatus @default(ACTIVE)
  revoked_at                    DateTime?
  // DECISION [pair-revoked-by]: kto zerwał relację — bez tego REVOKED było nierozróżnialne między rezygnacją klientki a usunięciem jej przez stylistkę, więc usunięta osoba jednostronnie cofała jedyną kontrolę „usuń tę osobę" (ponowna prośba podnosiła wiersz do PENDING, a PENDING otwiera komunikator); NULL = wiersze sprzed kolumny, liczone jak zerwanie po stronie klientki -> docs/DOMAIN/SCHEMA_DECISIONS.md#pair-revoked-by
  revoked_by                    AccountType?
  crm_note                      String?       @db.Text
  crm_note_updated_at           DateTime?

  // Komunikator stylistka<->klientka (jeden strumień per para). last_message_at =
  // denormalizacja do sortowania listy rozmów + wykrycia "ma wiadomości" bez
  // agregacji. *_last_read_at = per-strona znacznik przeczytania (unread =
  // wiadomości drugiej strony z created_at > mój last_read_at).
  last_message_at      DateTime?
  client_last_read_at  DateTime?
  stylist_last_read_at DateTime?
  // DECISION [pair-hidden-at] (D2, 2026-09-05): ukrycie rozmowy = WYCISZENIE po
  // JEDNEJ stronie pary. Strona ukrywająca: wątek znika ze skrzynki i liczników,
  // prośba o parowanie znika z listy oczekujących, zero powiadomień (mail/in-app)
  // dla nowych wiadomości i ponownych próśb. Druga strona NICZEGO się nie
  // dowiaduje (wysyłka zwraca sukces, wiadomości są zapisywane — anty-oracle).
  // Nowa wiadomość NIE odkrywa wątku; przywrócenie = null. Nullowalne, bez
  // backfillu; bez indeksu (zbiory ukrytych są małe, skrzynkę napędzają indeksy
  // (owner, last_message_at DESC, id DESC) z filtrem IS NULL).
  stylist_hidden_at    DateTime?
  client_hidden_at     DateTime?

  client_user     User                   @relation("ClientPairings", fields: [client_user_id], references: [id], onDelete: Cascade)
  stylist_account StylistAccount         @relation("StylistPairings", fields: [stylist_account_id], references: [account_id], onDelete: Cascade)
  messages        StylistClientMessage[]

  @@unique([client_user_id, stylist_account_id], name: "client_user_id_stylist_account_id")
  @@index([client_user_id, status, paired_at(sort: Desc)])
  @@index([stylist_account_id, status, paired_at(sort: Desc)])
  // Lista rozmów (per strona, najnowsza wiadomość pierwsza): pokrywa
  // getConversations_IO WHERE <owner> AND last_message_at IS NOT NULL ORDER BY last_message_at DESC.
  @@index([client_user_id, last_message_at(sort: Desc), id(sort: Desc)])
  @@index([stylist_account_id, last_message_at(sort: Desc), id(sort: Desc)])
}

enum PairingStatus {
  ACTIVE
  REVOKED
  // Prosba o polaczenie ze stalego kodu QR / publicznego profilu (2026-07-11):
  // wiersz PENDING NIE daje dostepu do CHRONIONYCH zasobow stylistki (galeria,
  // karta klientki, sesje — te sciezki filtruja status=ACTIVE). WYJATEK
  // (S75/S82, celowy): komunikator dopuszcza PENDING (canSendToPair) — klientka
  // moze napisac do stylistki PRZED akceptacja ("anuluj prosbe + napisz").
  // Powierzchnia spamu ograniczona: rate-limit 60/h/user + throttle mailowy
  // 15 min/pare + stylistka moze decline (REVOKED zamyka watek read-only).
  // Stylistka podnosi PENDING na ACTIVE (accept) albo znika/wraca do REVOKED
  // (decline). Claim kodu 15-min upsertuje PENDING→ACTIVE.
  PENDING
}

enum StylistClientMessageSender {
  STYLIST
  CLIENT
}

// Komunikator stylistka<->klientka: jeden ciągły strumień wiadomości per para
// (ClientStylistPair). Wysyłka dozwolona gdy para PENDING/ACTIVE (klientka może
// pisać czekając na akceptację prośby); REVOKED = historia read-only.
model StylistClientMessage {
  id          String                     @id @default(cuid())
  pair_id     String
  sender_type StylistClientMessageSender
  // @db.Text = long-form free text (parytet SupportMessage). Na Postgres bare String
  // i tak mapuje się na TEXT (unbounded) — anotacja jest jawnością intencji, nie zmianą
  // typu (VARCHAR(191) to zachowanie MySQL, nie PG).
  content     String                     @db.Text
  created_at  DateTime                   @default(now())

  pair ClientStylistPair @relation(fields: [pair_id], references: [id], onDelete: Cascade)

  // Thread + latest preview: Postgres reverse-scan obsługuje ASC listy wątku,
  // a DESC + id domyka deterministyczny latest-message lookup.
  @@index([pair_id, created_at(sort: Desc), id(sort: Desc)])
  // Conversation unread aggregate: pair + other-side + read timestamp cutoff.
  @@index([pair_id, sender_type, created_at(sort: Desc)])
}

