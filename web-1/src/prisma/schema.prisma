model ClientStylistPair {
  id                            String        @id @default(cuid())
  client_user_id                String
  stylist_account_id            String
  paired_at                     DateTime      @default(now())
  // DECISION [pair-request-notification-anchor]: CONTACT keeps the original request window after withdrawal
  last_pair_request_at          DateTime?
  // DECISION [clientstylistpair-soft-ref]: audit-only soft reference to PairingSession.id, guaranteed at app level
  paired_via_pairing_session_id String?
  status                        PairingStatus @default(ACTIVE)
  revoked_at                    DateTime?
  // DECISION [pair-revoked-by]: who ended the relation. Without it REVOKED could not tell a client leaving from a stylist removing her, so a removed person could unilaterally undo the only "remove this person" control (a new request lifted the row to PENDING, and PENDING opens messaging). NULL = rows from before the column, counted as ended by the client
  revoked_by                    AccountType?
  salon_origin_account_id       String?
  // DECISION [pair-request-context]: optional decision context, cleared when a request ends;
  // it is not part of the client's CRM record
  request_place                 String?       @db.VarChar(100)
  request_note                  String?       @db.VarChar(140)
  crm_note                      String?       @db.Text
  crm_note_updated_at           DateTime?
  // DECISION [pair-important-note]: the ONE thing the stylist must not miss before a visit (an allergy, a sensitivity). Written and read only by the stylist of the pair, never in a client-facing DTO; NOT plan-gated (safety information on every plan, Free included), unlike crm_note. Survives a disconnect like crm_note, cleared by its own empty write, erased with the pair by the account-deletion cascade
  important_note                String?       @db.VarChar(200)
  important_note_updated_at     DateTime?

  // One stylist-client thread per pair. last_message_at is denormalized so the
  // inbox can sort and detect "has messages" without an aggregate.
  // *_last_read_at is the per-side read mark (unread = the other side's
  // messages with created_at > my last_read_at).
  last_message_at      DateTime?
  client_last_read_at  DateTime?
  stylist_last_read_at DateTime?
  // DECISION [pair-hidden-at]: hiding a conversation is a MUTE on one side of the pair. The hiding side
  // loses the thread from inbox and counters, the pending request from its list, and gets no
  // notifications; the other side learns NOTHING (send succeeds and messages are stored, so there is no
  // oracle). A new message does not unhide; restore = null. Nullable, no backfill, no index (hidden
  // sets are small; the inbox runs on (owner, last_message_at DESC, id DESC) with IS NULL). (owner)
  stylist_hidden_at    DateTime?
  client_hidden_at     DateTime?

  client_user     User                   @relation("ClientPairings", fields: [client_user_id], references: [id], onDelete: Cascade)
  stylist_account StylistAccount         @relation("StylistPairings", fields: [stylist_account_id], references: [account_id], onDelete: Cascade)
  messages        StylistClientMessage[]

  @@unique([client_user_id, stylist_account_id], name: "client_user_id_stylist_account_id")
  @@index([salon_origin_account_id, status])
  @@index([client_user_id, status, paired_at(sort: Desc)])
  @@index([stylist_account_id, status, paired_at(sort: Desc)])
  // Lista rozmów (per strona, najnowsza wiadomość pierwsza): pokrywa
  // getConversations_IO WHERE <owner> AND last_message_at IS NOT NULL ORDER BY last_message_at DESC.
  @@index([client_user_id, last_message_at(sort: Desc), id(sort: Desc)])
  @@index([stylist_account_id, last_message_at(sort: Desc), id(sort: Desc)])
}

enum PairingStatus {
  ACTIVE
  REVOKED
  CONTACT
  // PENDING from a permanent QR or a public profile grants no protected access
  // (gallery, client card and sessions filter status=ACTIVE). Messaging allows
  // PENDING on purpose (canSendToPair): the client may write before acceptance
  // ("anuluj prosbe + napisz"). Spam surface: 60/h per user, a 15-minute mail
  // throttle per pair, and decline sets REVOKED (read-only). Accept lifts
  // PENDING to ACTIVE. A 15-minute code claim upserts PENDING to ACTIVE.
  PENDING
}

enum StylistClientMessageSender {
  STYLIST
  CLIENT
}

enum SessionActivityKind {
  TEXT
  SESSION_SUBMITTED
  SESSION_ACCEPTED
  SESSION_CHANGED
}

enum SessionChangeScope {
  PHOTOS
  NOTE
  PHOTOS_AND_NOTE
}

// Komunikator stylistka<->klientka: jeden ciągły strumień wiadomości per para
// (ClientStylistPair). Wysyłka dozwolona gdy para PENDING/ACTIVE (klientka może
// pisać czekając na akceptację prośby); REVOKED = historia read-only.
model StylistClientMessage {
  id          String                     @id @default(cuid())
  pair_id     String
  sender_type StylistClientMessageSender
  // @db.Text marks long-form free text (same intent as SupportMessage). On Postgres
  // a bare String is already unbounded TEXT, so the annotation states intent and
  // does not change the type (VARCHAR(191) is MySQL behavior, not Postgres).
  content     String                     @db.Text
  created_at  DateTime                   @default(now())

  kind         SessionActivityKind @default(TEXT)
  session_id   String?
  change_scope SessionChangeScope?
  event_key    String?             @unique
  activity_at  DateTime            @default(now())
  revision     Int                 @default(1)

  pair ClientStylistPair @relation(fields: [pair_id], references: [id], onDelete: Cascade)

  // Thread + latest preview: Postgres reverse-scan obsługuje ASC listy wątku,
  // a DESC + id domyka deterministyczny latest-message lookup.
  @@index([pair_id, created_at(sort: Desc), id(sort: Desc)])
  // Conversation unread aggregate: pair + other-side + read timestamp cutoff.
  @@index([pair_id, sender_type, created_at(sort: Desc)])
  @@index([pair_id, activity_at(sort: Desc), id(sort: Desc)])
  @@index([pair_id, sender_type, activity_at(sort: Desc)])
}

