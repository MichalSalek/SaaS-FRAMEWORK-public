// ┌─────────────────────────────────────────────────────────────────────────────┐
// │ 📖 UZASADNIENIA DECYZJI SCHEMATU -> docs/DOMAIN/SCHEMA_DECISIONS.md           │
// │ Inline poniżej = TYLKO 1-linijkowe wskaźniki `// DECISION [id] -> ...`.       │
// │ Pełna proza/rationale w pliku wyżej (anty-re-litygacja). Nie usuwać decyzji.  │
// └─────────────────────────────────────────────────────────────────────────────┘

generator client {
  output        = "./js-client"
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Better Auth Models

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  // DECISION [account-index-coverage]: index userId — Better Auth findMany per-login + GDPR cascade -> docs/DOMAIN/SCHEMA_DECISIONS.md#account-index-coverage
  @@index([userId])
}

model Session {
  id          String   @id @default(cuid())
  token       String   @unique @map("session_token")
  userId      String   @map("user_id")
  expires     DateTime
  ip_address  String?
  user_agent  String?
  device_type String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires])
  @@index([userId, expires])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([identifier, value])
}

// D23 (run 25): admin impersonation backup token storage. Plaintext admin
// session token never crosses the wire — only an opaque `ref_id` (DB lookup
// key) signed with HMAC rides in the `become-user` header. Single active
// impersonation per admin enforced via @unique on admin_user_id (a new
// `become-user` deletes any prior row for that admin).
model ImpersonationBackup {
  ref_id                     String   @id
  admin_user_id              String   @unique
  backup_session_token       String   @db.Text
  original_session_id        String
  // DECISION [impersonationbackup-caller-binding]: pozytywne wiązanie switch-back z DB; NOT NULL efemeryczne, migracja truncate-first -> docs/DOMAIN/SCHEMA_DECISIONS.md#impersonationbackup-caller-binding
  impersonated_user_id       String   @db.Text
  impersonated_session_token String   @db.Text
  expires_at                 DateTime
  created_at                 DateTime @default(now())

  @@index([expires_at])
}

// Business Domain Models

model AdminNote {
  id         String   @id @default(cuid())
  notes      String   @db.Text
  created_at DateTime @default(now())
}

model Policy {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  is_main    Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([is_main])
}

// Dynamic Permissions System

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())

  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String   @id @default(cuid())
  event_name  String   @unique
  description String?
  category    String
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())

  roles RolePermission[]

  @@index([category])
}

model RolePermission {
  id            String   @id @default(cuid())
  role_id       String
  permission_id String
  created_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([permission_id])
}

model EventLog {
  event_log_id       String       @id @default(cuid())
  created_at         DateTime     @default(now())
  event              String
  // DECISION [eventlog-soft-fk]: soft-FK: wiersz audytu przeżywa delete usera z niepodpiętym user_id -> docs/DOMAIN/SCHEMA_DECISIONS.md#eventlog-soft-fk
  created_by_user_id String
  language           String?
  location           String?
  user_agent         String?
  client_ip          String?
  event_payload      Json?
  event_type         EventLogType

  // User activity/timeline pagination. The first index covers an optional type
  // filter; the second covers the common all-types view. Both match total-order
  // created_at DESC + event_log_id DESC instead of forcing a per-user sort.
  @@index([created_by_user_id, event_type, created_at(sort: Desc), event_log_id(sort: Desc)])
  @@index([created_by_user_id, created_at(sort: Desc), event_log_id(sort: Desc)])
  // DD3-F3 (2026-05-26, pre-launch baseline regen):
  // Hot query patterns: `WHERE event=X AND created_at >= ?` (dunning, lifecycle sweeps)
  // and `WHERE event_type=Y AND created_at >= ?` (admin log filters, retention cleanup).
  // Composite indexes with created_at DESC for "recent events of type" pagination.
  @@index([event, created_at(sort: Desc)])
  @@index([event_type, created_at(sort: Desc)])
}

// AI Crawler Analytics — tracking who crawls /llms.txt, /robots.txt, /sitemap*.xml
// DECISION [aicrawler-varchar-indexes]: VarChar = defense-in-depth + composite (date,bot) indexes dla stats -> docs/DOMAIN/SCHEMA_DECISIONS.md#aicrawler-varchar-indexes
model AiCrawlerEvent {
  id           String   @id @default(cuid())
  created_at   DateTime @default(now())
  user_agent   String   @db.VarChar(2000)
  path         String   @db.VarChar(500) // /llms.txt, /llms-pl.txt, /robots.txt, /sitemap.xml, etc.
  ip_address   String?  @db.VarChar(100) // pełny adres IP crawlera, cap 100 znaków
  country      String?  @db.VarChar(10) // CF-IPCountry header (Cloudflare) lub null
  bot_name     String?  @db.VarChar(100) // parsed: GPTBot, ClaudeBot, PerplexityBot, Googlebot, etc.
  bot_category String?  @db.VarChar(50) // ai-training, ai-search, search-engine, seo-tool, social, unknown

  @@index([bot_name])
  @@index([bot_category])
  @@index([path])
  @@index([created_at, bot_name])
  @@index([created_at, bot_category])
}

// Stripe Webhook Idempotency
model StripeEvent {
  id              String    @id @default(cuid())
  event_id        String    @unique @map("eventId")
  event_type      String    @map("eventType")
  processed       Boolean   @default(false)
  processed_at    DateTime? @map("processedAt")
  created_at      DateTime  @default(now()) @map("createdAt")
  // D1 (run 25): janitor sweeper retry tracking + dead-letter handling.
  // DECISION [stripeevent-last-attempt-default]: @default(now()) by janitor sweepował po age mimo DB outage -> docs/DOMAIN/SCHEMA_DECISIONS.md#stripeevent-last-attempt-default
  retry_count     Int       @default(0) @map("retryCount")
  last_attempt_at DateTime  @default(now()) @map("lastAttemptAt")
  last_error      String?   @map("lastError") @db.Text
  dead_lettered   Boolean   @default(false) @map("deadLettered")

  // DD3-D8 (run 24): janitorial sweeper for unprocessed events ordered by age.
  // WHERE processed = false AND dead_lettered = false ORDER BY created_at.
  @@index([processed, dead_lettered, created_at])
  // Admin/diagnostics: list dead-lettered rows for manual triage.
  @@index([dead_lettered, created_at])
}

model StylistAccount {
  account_id              String              @id @default(cuid())
  created_at              DateTime            @default(now())
  created_by_user_id      String              @unique
  // DECISION [stylistaccount-display-name-nullable]: nullable w DB, app-required (walidator); odczyty z fallbackiem -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-display-name-nullable
  display_name            String?
  pricing_plan            PricingPlan
  payment_status          PaymentStatus
  account_status          AccountStatus
  // Seat-billing: kolumna ZOSTAJE, ale per-seat jako mechanizm CENNIKOWY = SKASOWANY
  // (Model B, owner 2026-07-19). Studio = CAŁY zespół w cenie do 10 kont (max_staff_members=9,
  // fair-use cap); paid_staff_seats NIEUŻYWANY jako dopłata (default 0, nie +35/seat). Guard
  // salon-staff nadal liczy effectiveLimit = max_staff_members + paid_staff_seats, więc kolumna
  // może służyć jako ewentualny RĘCZNY bump limitu (nie cennik). SSOT: pricing.policy.ts DECISION
  // (Model B) + PRICING_PACKAGING §2.4. Odwraca A-lite +35/seat (2026-07-12).
  paid_staff_seats        Int                 @default(0)
  account_expiration_date DateTime?
  upcoming_payment_date   DateTime?
  business_name           String?
  address_street          String?
  address_city            String?
  address_postal_code     String?
  address_country         String?
  latitude                Float?
  longitude               Float?
  phone                   String?
  website                 String?
  description             String?             @db.Text
  dashboard_note          String?             @db.Text
  vanity_url              String?             @unique
  // Public profile fields
  instagram_handle        String?
  // DECISION [stylistaccount-avatar]: wlasny upload zdjecia profilowego (account/set-avatar), null = fallback OAuth image -> inicjaly -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-avatar
  avatar_url              String?
  // DECISION [asset-public-id]: identyfikator pliku w chmurze wyprowadzony z adresu przy
  // zapisie; indeks zastepuje skan calej kolumny adresow w bramce wlasnosci pliku.
  // NULL = adresu nie dalo sie rozlozyc -> wiersz ZOSTAJE na wolniejszej sciezce
  // porownania w kodzie (patrz cloudinary-asset.guard.ts). Swiadomie BEZ @unique:
  // pytamy o istnienie, nie o unikalnosc, a ten sam plik moze byc legalnie wskazany
  // przez wiersz historyczny. -> docs/DOMAIN/SCHEMA_DECISIONS.md#asset-public-id
  avatar_public_id        String?
  // Branding-light krok 1 (BRANDING_VALUE_LADDER, 2026-07-11): kolor akcentu
  // publicznego profilu — hex z kuratorowanej palety kernela (walidacja
  // po stronie API), gate planu can_brand_profile (Pro Marka+).
  brand_accent_color      String?             @db.VarChar(7)
  // Stripe subscription fields
  stripe_customer_id      String?             @unique
  subscription_id         String?
  subscription_status     SubscriptionStatus?
  cancel_at_period_end    Boolean?            @default(false)
  cancel_at               DateTime?
  current_period_end      DateTime?
  // Out-of-order webhook guard: created-time of the most recent Stripe EVENT applied
  // to this account. Webhook plan-writes are gated on it (skip if event.created is
  // older) so a delayed/retried stale event cannot resurrect a canceled subscription.
  // Null = no Stripe event applied yet (first event always wins). Non-webhook callers
  // (login-sync / dunning) are authoritative and do NOT set/check it.
  last_stripe_event_at    DateTime?
  // Trial fields
  trial_started_at        DateTime?
  trial_ends_at           DateTime?
  trial_reminder_sent     Boolean?            @default(false)
  // DECISION [stylistaccount-plan-selected-at] (SPE D3, nie usuwaj): marker bramki wyboru planu,
  // ODDZIELNY od trial_started_at. Ustawiany przy jawnym wyborze planu: Free -> od razu (free-branch op),
  // paid -> przy utworzeniu checkout-session. App-guard: brak plan_selected_at -> redirect do wyboru planu.
  // Porzucony paid-checkout zostawia plan_selected_at=set ale pricing_plan=FREE/default -> user NIE zablokowany
  // (retry albo Free). Nullable, bez indeksu (read tylko per-account po PK). NIE myl z trial-lock.
  plan_selected_at        DateTime?
  // Email lifecycle preferences
  // DECISION [stylistaccount-marketing-by-design]: domyślny JSON ma marketing:true; faktyczną wartość zapisuje onboarding (kolumna email_marketing) -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-marketing-by-design
  email_preferences       Json?               @default("{\"trial_sequence\":true,\"marketing\":true}")
  // DECISION [stylistaccount-email-bool-authoritative]: Boolean = autorytatywna ścieżka (Phase 2 shipped); JSON = shadow/rollback -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-email-bool-authoritative
  email_marketing         Boolean             @default(true)
  email_trial_sequence    Boolean             @default(true)
  // DECISION [stylistaccount-admin-plan-override]: OWNER-001 — flaga chroni admin-set plan przed login-time Stripe sync -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-admin-plan-override
  admin_plan_override     Boolean             @default(false)
  // DECISION [stylistaccount-gallery-strength-dismissed-at]: decyzja stylistki o zamknieciu karty "Sila galerii" po osiagnieciu 100%; NULL = karta widoczna. Nie czyscimy jej przy spadku ponizej 100% — render decyduje po WYNIKU (score < 100 pokazuje karte mimo znacznika), wiec jedno zamkniecie nie gasi przyszlych podpowiedzi -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-gallery-strength-dismissed-at
  gallery_strength_dismissed_at DateTime?
  // Profile metrics
  view_count              Int                 @default(0)
  // DECISION [stylistaccount-cached-bookmark-count]: denormalized count anty-N+1; SoT = FavoriteStylist, drift recovery skryptem -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-cached-bookmark-count
  cached_bookmark_count   Int                 @default(0)
  // DECISION [stylistaccount-cached-gallery-count]: denormalized count anty-N+1; liczy WIDOCZNE rekordy (is_hidden=false) — parytet z write-path (gallery-count.helper) + backfill; RC-011 (wczesniejszy ALL-count driftowal public photo_count) -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-cached-gallery-count
  cached_gallery_count    Int                 @default(0)
  // DECISION [stylistaccount-cached-likes-count]: denormalized count anty-N+1; SoT = FavoriteGalleryRecord JOIN GalleryRecord WHERE is_hidden=false (lajki WIDOCZNYCH rekordow); single-owner writer favorite-count.helper.ts; drift recovery via cached-counts-backfill -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-cached-likes-count
  cached_likes_count      Int                 @default(0)
  created_by_user         User                @relation("StylistAccountRelation", fields: [created_by_user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gallery_record          GalleryRecord[]     @relation("GalleryRecordRelation")
  favorited_by            FavoriteStylist[]   @relation("StylistBookmarks")
  stylist_pairings        ClientStylistPair[] @relation("StylistPairings")
  pairing_sessions        PairingSession[]    @relation("StylistPairingSessions")
  staff_members           StaffMember[]       @relation("SalonStaff")
  session_containers      SessionContainer[]
  stylist_visits          VisitRecord[]       @relation("StylistVisits")

  @@index([account_status, address_city, latitude, longitude])
  @@index([subscription_status])
  // Explore query: filter ACTIVE accounts then join via account_id — covering index for the subquery plan
  @@index([account_status, account_id])
  // DECISION [stylistaccount-explore-orderby-index]: covering index dla getStylistsWithLocation ORDER BY (H9 fix) -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-explore-orderby-index
  @@index([account_status, cached_gallery_count(sort: Desc)])
  @@index([avatar_public_id])
  // Email sweep query: WHERE trial_started_at IS NOT NULL — avoids full table scan
  @@index([trial_started_at]) // redundant-index-allow: retained for trial_started_at-only email-sweep scans (documented retention; technically covered by [trial_started_at, payment_status])
  // PRMA C1-F2 (2026-05-27, HIGH): hot dunning + lifecycle sweeps filter on
  // trial_started_at AND payment_status (e.g., trials still UNPAID after N days). Composite
  // accelerates the AND clause; single-column index above retained for trial_started_at-only scans.
  @@index([trial_started_at, payment_status])
  // DECISION [stylistaccount-billing-cron-index]: paid-lifecycle crons (renewal-reminder: payment_status=PAID
  // + current_period_end BETWEEN range ORDER BY current_period_end ASC; dunning-downgrade: payment_status=IN_PROGRESS
  // ORDER BY current_period_end ASC). Composite serves the equality partition + range/seek AND eliminates the sort
  // (current_period_end was in zero indexes). -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-billing-cron-index
  @@index([payment_status, current_period_end])
  // City filter (Explore + public stylists list) — equality lookup without lat/lng dependency
  @@index([address_city])
  // DECISION [stylistaccount-gin-trigram]: per-column GIN trgm dla fuzzy search (ILIKE), pg_trgm manual w migration -> docs/DOMAIN/SCHEMA_DECISIONS.md#stylistaccount-gin-trigram
  @@index([display_name(ops: raw("gin_trgm_ops"))], type: Gin, map: "stylist_account_display_name_trgm_idx")
  @@index([business_name(ops: raw("gin_trgm_ops"))], type: Gin, map: "stylist_account_business_name_trgm_idx")
  @@index([address_city(ops: raw("gin_trgm_ops"))], type: Gin, map: "stylist_account_address_city_trgm_idx")
}

model ClientAccount {
  client_account_id  String   @id @default(cuid())
  created_at         DateTime @default(now())
  created_by_user_id String   @unique

  // Contact information (visible only to paired stylists)
  contact_phone String?
  contact_email String?

  dashboard_note String? @db.Text

  created_by_user    User               @relation("ClientAccountRelation", fields: [created_by_user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  session_containers SessionContainer[]

  @@index([contact_phone])
  @@index([contact_email])
}

model Color {
  id            String   @id @default(cuid())
  name          String   @unique
  hex_code      String
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  gallery_records GalleryRecordColor[]

  @@index([is_active, display_order])
}

model Trait {
  id            String   @id @default(cuid())
  name          String   @unique
  category      String // 'technique', 'finish', 'decoration', 'style'
  icon_url      String?
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  is_featured   Boolean  @default(false)
  created_at    DateTime @default(now())

  gallery_records GalleryRecordTrait[]

  @@index([is_active, is_featured(sort: Desc), category, display_order])
  @@index([category])
}

model GalleryRecordColor {
  id                String   @id @default(cuid())
  gallery_record_id String
  color_id          String
  created_at        DateTime @default(now())

  gallery_record GalleryRecord @relation(fields: [gallery_record_id], references: [gallery_record_id], onDelete: Cascade)
  color          Color         @relation(fields: [color_id], references: [id], onDelete: Cascade)

  @@unique([gallery_record_id, color_id])
  // Explore query: EXISTS subquery seeks color_id then needs gallery_record_id for join — covering index
  @@index([color_id, gallery_record_id])
}

model GalleryRecordTrait {
  id                String   @id @default(cuid())
  gallery_record_id String
  trait_id          String
  created_at        DateTime @default(now())

  gallery_record GalleryRecord @relation(fields: [gallery_record_id], references: [gallery_record_id], onDelete: Cascade)
  trait          Trait         @relation(fields: [trait_id], references: [id], onDelete: Cascade)

  @@unique([gallery_record_id, trait_id])
  // Explore query: EXISTS subquery seeks trait_id then needs gallery_record_id for join — covering index
  @@index([trait_id, gallery_record_id])
}

model GalleryRecord {
  gallery_record_id        String                  @id @default(cuid())
  created_at               DateTime                @default(now())
  created_by_account_id    String
  asset_url                String
  // DECISION [asset-public-id]: identyfikator pliku w chmurze wyprowadzony z adresu przy
  // zapisie; indeks zastepuje skan calej kolumny adresow w bramce wlasnosci pliku.
  // NULL = adresu nie dalo sie rozlozyc -> wiersz ZOSTAJE na wolniejszej sciezce
  // porownania w kodzie (patrz cloudinary-asset.guard.ts). Swiadomie BEZ @unique:
  // pytamy o istnienie, nie o unikalnosc, a ten sam plik moze byc legalnie wskazany
  // przez wiersz historyczny. -> docs/DOMAIN/SCHEMA_DECISIONS.md#asset-public-id
  public_id                String?
  nail_length              NailLength
  is_pinned                Boolean                 @default(false)
  is_hidden                Boolean                 @default(false)
  created_by_account       StylistAccount          @relation("GalleryRecordRelation", fields: [created_by_account_id], references: [account_id], onDelete: Cascade, onUpdate: Cascade)
  favorited_by             FavoriteGalleryRecord[] @relation("FavoriteRecords")
  colors                   GalleryRecordColor[]
  traits                   GalleryRecordTrait[]
  content_reports          ContentReport[]
  session_container_photos SessionContainerPhoto[]

  @@index([is_pinned, created_at(sort: Desc)])
  @@index([created_by_account_id, nail_length])
  // Explore query: filter by nail_length + ORDER BY created_at DESC — avoids sort step
  @@index([nail_length, created_at(sort: Desc)])
  // Explore query: cursor pagination seeks (created_at, gallery_record_id) for stable ordering
  @@index([created_at(sort: Desc), gallery_record_id])
  // PRMA C1-F1 (2026-05-27, CRITICAL): public profile + Explore feed dominant queries always
  // include is_hidden filter (= false) and order by created_at DESC. Composite indexes below cover
  // both per-account profile pagination and global Explore pagination with a single seek.
  @@index([created_by_account_id, is_hidden, created_at(sort: Desc)])
  @@index([is_hidden, created_at(sort: Desc)])
  // Public profile gallery (publicGetGalleryRecordsByAccount_IO): WHERE created_by_account_id
  // + is_pinned=true + is_hidden=false ORDER BY created_at DESC (+ gallery_record_id tiebreaker).
  // Covers equality prefix + sort in one seek; existing [..,is_pinned] / [..,is_hidden,created_at]
  // indexes each miss one predicate so the planner falls back to a sort.
  @@index([created_by_account_id, is_pinned, is_hidden, created_at(sort: Desc)])
  // Paired-client gallery (getGalleryForPairedClient_IO): WHERE created_by_account_id + is_hidden
  // ORDER BY is_pinned DESC, created_at DESC, gallery_record_id DESC. Covers the multi-key sort
  // (is_pinned → created_at → cuid tiebreaker) so pinned-first pagination is a single index walk.
  @@index([created_by_account_id, is_pinned, created_at(sort: Desc), gallery_record_id])
  @@index([public_id])
}

model User {
  id                     String      @id @default(cuid())
  email                  String      @unique
  emailVerified          Boolean     @default(false) @map("email_verified")
  image                  String?
  name                   String      @default("") @db.VarChar(200)
  role_id                String
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  is_active              Boolean     @default(true)
  disabled_at            DateTime?   @map("disabled_at")
  // DECISION [user-soft-delete-model-a]: Model A soft-delete §13.1; deleted_at=self vs disabled_at=ban -> docs/DOMAIN/SCHEMA_DECISIONS.md#user-soft-delete-model-a
  deleted_at             DateTime?   @map("deleted_at")
  recovery_available     Boolean     @default(false) @map("recovery_available")
  account_type           AccountType @default(CLIENT)
  notifications_enabled  Boolean     @default(true)
  // DECISION [user-terms-accepted-at]: first acceptance of terms + 16+ declaration, stamped by onboarding -> docs/DOMAIN/SCHEMA_DECISIONS.md#user-terms-accepted-at
  terms_accepted_at      DateTime?   @map("terms_accepted_at")
  moderation_strikes     Int         @default(0)
  // DECISION [user-delete-confirm-version]: monotoniczny licznik unieważniający single-use delete-token (anty-replay) -> docs/DOMAIN/SCHEMA_DECISIONS.md#user-delete-confirm-version
  delete_confirm_version Int         @default(0)

  // Relations
  role                      Role                    @relation(fields: [role_id], references: [id])
  stylist_account           StylistAccount?         @relation("StylistAccountRelation")
  client_account            ClientAccount?          @relation("ClientAccountRelation")
  favorite_stylists         FavoriteStylist[]       @relation("ClientBookmarks")
  favorite_records          FavoriteGalleryRecord[] @relation("ClientFavoriteRecords")
  client_pairings           ClientStylistPair[]     @relation("ClientPairings")
  client_visits             VisitRecord[]           @relation("ClientVisits")
  staff_memberships         StaffMember[]           @relation("StaffMemberships")
  announcements             Announcement[]          @relation("AnnouncementRelation")
  runtime_config_updates    RuntimeConfig[]         @relation("RuntimeConfigUpdater")
  moderation_strike_records ModerationStrike[]      @relation("ModerationStrikeRelation")

  // Better Auth relations
  accounts Account[]
  sessions Session[]

  @@index([role_id])
  @@index([name])
  @@index([is_active])
  @@index([createdAt])
  // Recovery cron: WHERE recovery_available=true AND deleted_at < (now-90d) (DOMAIN_SSOT §13.1)
  @@index([recovery_available, deleted_at])
  // PLQS C1-5D (2026-05-28): admin metrics GROUP BY account_type + admin user-list
  // filter by type ordered by date. Composite avoids full table scan + sort step.
  @@index([account_type, createdAt(sort: Desc)])
  // DECISION [user-gin-trigram]: per-column GIN trgm dla fuzzy admin user-search (ADMIN_GET_USERS_PAGINATED
  // ILIKE %term% na email+name — leading wildcard omija btree). Mirror wzorca StylistAccount GIN trgm,
  // pg_trgm manual w migration. -> docs/DOMAIN/SCHEMA_DECISIONS.md#user-gin-trigram
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@map("users") // REQUIRED by Better Auth adapter mapping - users table name.
}

