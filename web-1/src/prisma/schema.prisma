  updated_at         DateTime          @updatedAt

  client_user     User               @relation("ClientVisits", fields: [client_user_id], references: [id], onDelete: Cascade)
  stylist_account StylistAccount     @relation("StylistVisits", fields: [stylist_account_id], references: [account_id], onDelete: Cascade)
  session         SessionContainer?  @relation("SessionVisit", fields: [session_id], references: [id], onDelete: SetNull)
  result_photos   VisitResultPhoto[]

  @@index([stylist_account_id, client_user_id, visit_date(sort: Desc)])
  @@index([client_user_id, visit_date(sort: Desc)])
}

model VisitResultPhoto {
  id                 String   @id @default(cuid())
  visit_record_id    String
  stylist_account_id String
  asset_url          String
  // DECISION [asset-public-id]: cloud file id derived from the URL on write; the index replaces a full
  // URL-column scan in the ownership gate. NULL = URL not parseable, the row stays on the slower
  // in-code comparison path (cloudinary-asset.guard.ts). No @unique on purpose: the gate asks
  // "exists", and a historical row may legitimately point at the same file.
  public_id          String?
  position           Int      @default(0)
  created_at         DateTime @default(now())

  visit_record VisitRecord @relation(fields: [visit_record_id], references: [id], onDelete: Cascade)

  @@unique([visit_record_id, position])
  @@index([public_id])
}

// ─��� Email Dead Letter ──────────────────────────────────────────────────────────

model FailedEmail {
  id          String    @id @default(cuid())
  recipient   String
  template    String
  subject     String
  payload     Json
  error       String
  attempts    Int       @default(3)
  created_at  DateTime  @default(now())
  resolved_at DateTime?
  // DECISION [failedemail-resolved-soft-fk]: resolved_by = soft-FK audit trail (the closing admin), append-only over integrity
  resolved_by String?

  @@index([created_at])
  @@index([resolved_at])
  // PLQS C1-5D (2026-05-28): admin lookup / dedup by recipient email address.
  @@index([recipient])
}

// ── Support Messaging ──────────────────────────────────────────────────────────

enum SupportThreadStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum SupportSenderType {
  USER
  SUPPORT
}

// What the request is about, picked by the user instead of typing a subject.
enum SupportThreadCategory {
  QUESTION
  BILLING
  BUG
  IDEA
  ACCOUNT
  OTHER
}

model SupportThread {
  id                String                 @id @default(cuid())
  user_id           String
  // Derived by the server from the first line of the first message
  // (support-subject.resolver.ts); still NOT NULL and still the title everywhere.
  subject           String
  // DECISION [supportthread-category]: nullable; null = a thread created before categories existed, never backfilled
  category          SupportThreadCategory?
  status            SupportThreadStatus    @default(OPEN)
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  // DECISION [supportthread-user-last-read-at]: the moment the OWNER of the thread last opened it. A thread has an unread
  // reply when a SUPPORT message exists with created_at > user_last_read_at.
  // The default makes every existing and every new thread start as "read", so
  // shipping the marker lights no badge for history. Written ONLY by raw SQL
  // (support-read-marker.operations.ts): a Prisma update would bump
  // @updatedAt, which is the admin's optimistic-concurrency token.
  user_last_read_at DateTime               @default(now())

  // DECISION [supportthread-soft-fk]: user_id = soft-FK; support history survives a hard delete or MOVE of the user
  messages SupportMessage[]

  @@index([user_id])
  // PRMA C1-F3 (2026-05-27, HIGH): admin support queue paginates threads filtered by status
  // ordered by id DESC (cuid lexicographic ~= insertion order). Composite removes sort step
  // for the dominant "list OPEN threads, newest first" admin query.
  // DECISION [supportthread-status-index]: no standalone [status]: the composite [status, id DESC] covers it as a left prefix
  @@index([status, id(sort: Desc)])
}

model SupportMessage {
  id          String            @id @default(cuid())
  thread_id   String
  sender_type SupportSenderType
  // @db.Text marks unbounded long-form (paragraphs, stack traces). On Postgres a
  // bare String is already TEXT, so the annotation states intent and does not
  // change the type (VARCHAR(191) is MySQL, not Postgres). CONTENT_MAX=2000 fits.
  content     String            @db.Text
  created_at  DateTime          @default(now())

  thread SupportThread @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  // PLQS C1-5D (2026-05-28): message listing always orders by created_at ASC within a thread.
  // Composite eliminates the sort step for getSupportThreadMessages_IO + adminGetThreadMessages_IO.
  @@index([thread_id, created_at(sort: Asc)])
}

// Moderation Strikes — rolling window (365 days).
// Each strike is a time-bounded record. Active = expires_at > now().
// User.moderation_strikes kept for backwards compat (monotonic counter).
model ModerationStrike {
  id         String   @id @default(cuid())
  user_id    String
  // DECISION [moderationstrike-reason-varchar]: VarChar(2000) MUST equal STRIKE_REASON_MAX; narrower => 22001 truncation rollback
  reason     String   @db.VarChar(2000)
  issued_at  DateTime @default(now())
  expires_at DateTime
  // DECISION [moderationstrike-issued-by-soft-fk]: issued_by = soft-FK audit trail (the issuing admin), append-only over integrity
  issued_by  String

  user User @relation("ModerationStrikeRelation", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at(sort: Desc)])
}

// DECISION: showcase selection belongs to a salon, never to the author.
// Membership and contribution are checked on every read, so leaving cannot expose works.
model SalonShowcaseWork {
  salon_account_id  String
  gallery_record_id String
  salon             StylistAccount @relation(fields: [salon_account_id], references: [account_id], onDelete: Cascade)
  work              GalleryRecord  @relation(fields: [gallery_record_id], references: [gallery_record_id], onDelete: Cascade)

  @@id([salon_account_id, gallery_record_id])
  @@index([gallery_record_id])
}

// Notification centre: one row per event worth telling the recipient, rendered
// by the reader from `type` and `actor_name`
// (domain/notifications/notification-copy.config.ts).

enum NotificationType {
  SYSTEM_ANNOUNCEMENT
  PAIR_REQUEST_RECEIVED
  PAIR_REQUEST_ACCEPTED
  PAIR_CONNECTED_BY_QR
  SESSION_SHARED
  SESSION_CLOSED_BY_STYLIST
  SESSION_EXPIRING_SOON
  MESSAGE_RECEIVED
  SALON_INVITATION_RECEIVED
  SALON_INVITATION_ACCEPTED
  SUPPORT_REPLY_RECEIVED
}

enum PushPlatform {
  WEBPUSH
  FCM
}

model Notification {
  id              String           @id @default(cuid())
  user_id         String
  // null = adresowane do osoby, nie do roli (zaproszenie do salonu); STYLIST/CLIENT =
  // widoczne tylko w tym trybie konta („konto idzie za aktywną rolą", owner).
  recipient_role  AccountType?
  type            NotificationType
  // DECISION [notification-dedup-key]: `TYPE:eventId`, unique per recipient. A repeat emit inserts no second row because @@unique([user_id, dedup_key]); a message is one row per conversation and an upsert re-arms it
  dedup_key       String           @db.VarChar(200)
  actor_user_id   String?
  actor_name      String?          @db.VarChar(200)
  // DECISION [announcement-notification-cascade]: deleting a broadcast withdraws its bells;
  // a push already delivered cannot be withdrawn
  announcement_id String?
  announcement    Announcement?    @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  target_path     String           @db.VarChar(300)
  created_at      DateTime         @default(now())
  read_at         DateTime?

  activity_kind SessionActivityKind?
  session_id    String?
  change_scope  SessionChangeScope?

  user User @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, dedup_key])
  @@index([announcement_id])
  // Lista: najnowsze pierwsze, deterministyczny tiebreaker po id.
  @@index([user_id, created_at(sort: Desc), id(sort: Desc)])
  // Licznik nieprzeczytanych: WHERE user_id = ? AND read_at IS NULL.
  @@index([user_id, read_at])
  // Sweep retencji (notification-cleanup): WHERE created_at < now - 90d.
  @@index([created_at])
}

model PushSubscription {
  id           String       @id @default(cuid())
  user_id      String
  platform     PushPlatform
  // DECISION [pushsubscription-endpoint-unique]: the push-service address (web) or the FCM token, unique globally. One device belongs to one person; registering again reassigns the owner (a shared phone) instead of inserting a second row
  endpoint     String       @unique @db.VarChar(1000)
  p256dh       String?      @db.VarChar(200)
  auth         String?      @db.VarChar(100)
  user_agent   String?      @db.VarChar(300)
  created_at   DateTime     @default(now())
  last_seen_at DateTime     @default(now())
  failed_at    DateTime?

  user User @relation("UserPushSubscriptions", fields: [user_id], references: [id], onDelete: Cascade)

  // Wysyłka: WHERE user_id = ? AND failed_at IS NULL.
  @@index([user_id, failed_at])
  // Sweep: WHERE last_seen_at < now - 180d.
  @@index([last_seen_at])
}

// Minimal completion records survive detailed lifecycle retention.
model FreeEmailEnrollment {
  id           String    @id @default(uuid())
  accountId    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort       String
  version      String
  startedAt    DateTime
  status       String    @default("active")
  finishedAt   DateTime?
  finishReason String?

  @@index([userId])
  @@index([status, startedAt])
}

model EmailLifecycleCampaign {
  id            String    @id
  mode          String    @default("OFF")
  startedAt     DateTime?
  initializedAt DateTime?
  updatedAt     DateTime  @updatedAt
}

model EmailLifecycleMessage {
  id                   String                           @id @default(uuid())
  userId               String
  user                 User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String
  family               String
  ruleId               String
  templateId           String
  occurrence           String
  contentVersion       String
  sweepId              String?
  opportunityId        String?
  nonTransactional     Boolean                          @default(true)
  recipientAddressHash String?
  locale               String
  cohort               String
  ctaIds               String[]
  status               String                           @default("reserved")
  provider             String?
  providerMessageId    String?
  scheduledAt          DateTime
  createdAt            DateTime                         @default(now())
  startedAt            DateTime?
  acceptedAt           DateTime?
  deliveryStatus       String?
  deliveryAt           DateTime?
  reason               String?
  // DECISION [email-outbox]: durable send intent of important account/billing mail on THIS ledger (no parallel table)
  outbox               Boolean                          @default(false)
  outboxPayload        Json?
  attempts             Int                              @default(0)
  nextAttemptAt        DateTime?
  deadLetteredAt       DateTime?
  deliveryEvents       EmailDeliveryEvent[]
  entries              EmailLifecycleEntry[]
  operationalEvents    EmailLifecycleOperationalEvent[]

  @@unique([accountId, occurrence, ruleId])
  @@unique([accountId, occurrence, opportunityId])
  @@unique([provider, providerMessageId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([outbox, status, nextAttemptAt])
}

model EmailDeliveryEvent {
  id              String                @id @default(uuid())
  provider        String
  providerEventId String
  replayToken     String?
  messageId       String
  message         EmailLifecycleMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind            String
  occurredAt      DateTime
  createdAt       DateTime              @default(now())

  @@unique([provider, providerEventId])
  @@unique([provider, replayToken])
  @@index([messageId])
  @@index([createdAt])
}

model EmailDeliverySuppression {
  addressHash String   @id
  reason      String
  createdAt   DateTime @default(now())
}

model EmailLifecycleEntry {
  id        String                @id
  messageId String
  message   EmailLifecycleMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ctaId     String
  createdAt DateTime              @default(now())

  @@index([messageId])
  @@index([userId, createdAt])
}

model EmailLifecycleOperationalEvent {
  id         String                 @id @default(uuid())
  messageId  String?
  message    EmailLifecycleMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind       String
  state      String?
  reason     String?
  dimensions Json
  occurredAt DateTime               @default(now())
  exportedAt DateTime?

  @@index([messageId])
  @@index([exportedAt, occurredAt])
}

model EmailLifecycleAction {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  kind       String
  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
}

// ─── Retired profile links (owner) ───────────────────────────────
// A stylist's personal link (vanity_url) or a salon link (salon_vanity_url) that
// was replaced stays reserved for its owner and 301-redirects to the current one.

enum ProfileLinkKind {
  STYLIST
  SALON
}

model ProfileLinkAlias {
  kind       ProfileLinkKind
  // DECISION [profile-link-alias]: a retired link is reserved for its account FOREVER and resolves to the account's CURRENT link (no chains); unique per kind, same lowercase namespace as the live column; changing back to her own old link deletes the alias
  slug       String          @db.VarChar(100)
  account_id String
  created_at DateTime        @default(now())

  account StylistAccount @relation(fields: [account_id], references: [account_id], onDelete: Cascade, onUpdate: Cascade)

  @@id([kind, slug])
  @@index([account_id])
}
