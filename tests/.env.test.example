# =============================================================================
# Pakiet: tests/  (suite QA — smoke API + e2e Playwright + audyty shell)
#
# NIE jest deployowany. Ladowany przez tests/config/test.config.ts (dotenv).
# Skopiuj ten plik do `tests/.env.test` i uzupelnij wartosci.
#
# LEGENDA:
#   [REQUIRED] — brak => app/test pada (throw w config) lub feature off.
#   [OPTIONAL] — ma sensowny default (podany w komentarzu), mozna pominac.
#
# SEKRETY: ten plik to TYLKO szablon (placeholdery). NIGDY realnego sekretu tutaj.
#
# DWA ROZLACZNE SWIATY KONFIGU:
#   - smoke (z hosta)  -> TEST_API_URL / TEST_ORIGIN  (test.config.ts)
#   - e2e (Playwright) -> E2E_FRONTEND_URL / E2E_BACKEND_URL  (e2e/helpers/env.ts)
# =============================================================================

# --- Auth / Identity ---
# [REQUIRED] Email master-admina do logowania w testach; jedyny throw w test.config.ts (brak => crash setupu). MUST match web-1/.env.development. Shape: email (CSV emaili).
MASTER_ADMIN_EMAIL=admin@example.com

# --- Internal secrets (must match web-1 backend) ---
# [REQUIRED-de-facto] Naglowek x-internal-secret do /api/auth/dev-login Ustaw, jesli backend wymaga sekretu; MUST match INTERNAL_SHARED_SECRET w web-1. W kontenerze dziedziczone z env_file (dotenv nie nadpisuje process.env). Shape: secret hex 64-char.
INTERNAL_SHARED_SECRET=<64-hex-char-secret>
# [OPTIONAL] Override bazy HMAC do generowania delete-confirm tokenow (recovery-domain smoke). Brak => hardcoded dev-fallback w tescie (lub dziedziczy z web-1 w kontenerze). MUST match web-1 jesli ustawiasz. Shape: secret base64.
# EMAIL_UNSUBSCRIBE_SECRET=<base64-secret>

# --- Public URLs: smoke (test.config.ts) ---
# [OPTIONAL] Base URL backendu dla smoke-testow. Default: http://localhost:3001. Shape: URL.
TEST_API_URL=http://localhost:3001
# [OPTIONAL] Wartosc naglowka Origin requestow (CORS/origin-check). Default: http://localhost:3000. Shape: URL.
TEST_ORIGIN=http://localhost:3000

# --- Public URLs: e2e Playwright (e2e/helpers/env.ts) ---
# [OPTIONAL] Base URL frontendu dla Playwright (baseURL + ORIGIN). Default: http://localhost:3000. Shape: URL.
E2E_FRONTEND_URL=http://localhost:3000
# [OPTIONAL] Base URL backendu dla e2e helperow API. Default: http://localhost:3001. Shape: URL.
E2E_BACKEND_URL=http://localhost:3001

# --- Public URLs: visual QA (scripts/qa-screenshot.cjs, skill /ui) ---
# [OPTIONAL] Base URL dla screenshotow visual-QA. Default: http://localhost:3000. Shape: URL.
# BASE_URL=http://localhost:3000

# --- Runtime flags ---
# [OPTIONAL] Tryb srodowiska — toleruje 500 (brak SMTP) tylko gdy DEVELOPMENT (coverage-gap smoke); inaczej 500 = regresja. W praktyce dziedziczone z web-1/Docker, nie deklaruj tu. Default: brak (=> 500 traktowane jak regresja). Shape: enum DEVELOPMENT|STAGING|PRODUCTION.
# NODE_ENV_MANUAL=DEVELOPMENT
# [OPTIONAL] Przerwij smoke-suite na pierwszym failu (alt: flaga --fail-fast). Default: false. Shape: boolean ('true').
# SMOKE_FAIL_FAST=true
# [OPTIONAL] Debug: uruchom Playwright z GUI. Ustawiane przez `npm run test:e2e:headed`, rzadko recznie. Default: headless. Shape: '1'.
# HEADED=1

# --- Platform-injected (NIE deklaruj — wstrzykuje CI) ---
# CI — steruje forbidOnly + retries w playwright.config.ts (GitHub Actions itp.).
