{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@kernel/*": ["../.shared-kernel/*"]
    }
  },
  "include": ["**/*.ts", "../.shared-kernel/**/*.ts"],
  "exclude": ["node_modules", "dist", "../node_modules"]
}
